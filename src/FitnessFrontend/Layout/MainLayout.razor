@inherits LayoutComponentBase
@implements IDisposable
@using FitnessFrontend.Servicios.Identidad
@inject IAutenticacionService AutenticacionService
@inject NavigationManager NavigationManager

<div class="d-flex flex-column min-vh-100">
    <header>
        <div class="itm-barra">
            @* Logo oficial sin modificar y sin texto al lado (manual de imagen, "usos incorrectos") *@
            <a class="itm-marca-img" href="/eventos" aria-label="Ir al inicio">
                <img class="itm-logo" src="img/itm-horizontal-blanco.png" alt="ITM, Institución Universitaria" />
            </a>

            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Roles="Administrador" Context="adminContext">
                        <Authorized>
                            <NavMenuAdministrador />
                        </Authorized>
                        <NotAuthorized>
                            <AuthorizeView Roles="Entrenador" Context="entrenadorContext">
                                <Authorized>
                                    <NavMenuEntrenador />
                                </Authorized>
                                <NotAuthorized>
                                    <NavMenuUsuario />
                                </NotAuthorized>
                            </AuthorizeView>
                        </NotAuthorized>
                    </AuthorizeView>

                    <div class="itm-barra__derecha">
                        <span class="itm-barra__usuario">@context.User.Identity?.Name</span>
                        <AuthorizeView Roles="Administrador,Entrenador" Context="menuContext">
                            <Authorized>
                                <button type="button" class="btn-barra itm-menu-boton" aria-expanded="@(_menuAbierto ? "true" : "false")" aria-controls="menu-movil" @onclick="AlternarMenu">
                                    Menú
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <button type="button" class="btn-barra" @onclick="CerrarSesion">Cerrar sesión</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="itm-barra__derecha">
                        <a href="login" class="btn-barra">Iniciar sesión</a>
                        <a href="registro" class="btn-barra btn-barra--solido">Registrarse</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Celular, Administrador y Entrenador: tienen más de 3 destinos, así que el menú se despliega bajo la barra *@
        <AuthorizeView Roles="Administrador,Entrenador" Context="desplegableContext">
            <Authorized>
                @if (_menuAbierto)
                {
                    <div class="itm-menu-movil" id="menu-movil">
                        <AuthorizeView Roles="Administrador" Context="adminMovil">
                            <Authorized><NavMenuAdministrador /></Authorized>
                            <NotAuthorized><NavMenuEntrenador /></NotAuthorized>
                        </AuthorizeView>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </header>

    <main id="main-content" class="flex-grow-1 d-flex flex-column">
        @Body
    </main>

    <footer class="itm-pie">
        <div class="itm-contenedor">
            <strong>Bienestar Universitario · Gimnasio</strong>
            Institución Universitaria ITM · Medellín, Colombia
        </div>
    </footer>

    @* Usuario (ni Administrador ni Entrenador) en celular: barra inferior *@
    <AuthorizeView Roles="Administrador,Entrenador" Context="sinTabs">
        <Authorized />
        <NotAuthorized>
            <AuthorizeView Context="conSesion">
                <Authorized><NavTabsUsuario /></Authorized>
            </AuthorizeView>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _menuAbierto;

    protected override void OnInitialized() => NavigationManager.LocationChanged += AlCambiarRuta;

    private void AlternarMenu() => _menuAbierto = !_menuAbierto;

    private void AlCambiarRuta(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_menuAbierto)
        {
            _menuAbierto = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task CerrarSesion()
    {
        _menuAbierto = false;
        await AutenticacionService.CerrarSesionAsync();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose() => NavigationManager.LocationChanged -= AlCambiarRuta;
}
