@inherits LayoutComponentBase
@implements IDisposable
@using FitnessFrontend.Servicios.Identidad
@using FitnessFrontend.Componentes.Compartidos
@inject IAutenticacionService AutenticacionService
@inject NavigationManager NavigationManager

<div class="d-flex flex-column min-vh-100">
    <header>
        <div class="itm-barra">
            @* Logo oficial sin modificar y sin texto al lado (manual de imagen, "usos incorrectos") *@
            <a class="itm-marca-img" href="/eventos" aria-label="Ir al inicio">
                <img class="itm-logo" src="img/itm-horizontal-blanco.png" alt="ITM, Institución Universitaria" />
            </a>

            <AuthorizeView>
                <Authorized>
                    @* Administrador: sus 10 destinos no caben en la barra; van en el panel del botón "Menú" (todos los anchos).
                       Entrenador: 2 destinos en la barra (≥ 720 px) y el botón "Menú" solo en celular. *@
                    <AuthorizeView Roles="Administrador" Context="adminContext">
                        <NotAuthorized>
                            <AuthorizeView Roles="Entrenador" Context="entrenadorContext">
                                <Authorized>
                                    <NavMenuEntrenador />
                                </Authorized>
                                <NotAuthorized>
                                    <NavMenuUsuario />
                                </NotAuthorized>
                            </AuthorizeView>
                        </NotAuthorized>
                    </AuthorizeView>

                    <div class="itm-barra__derecha">
                        <span class="itm-barra__usuario">@context.User.Identity?.Name</span>
                        <AuthorizeView Roles="Administrador" Context="menuAdmin">
                            <Authorized>
                                <button type="button" class="btn-barra itm-menu-boton itm-menu-boton--siempre" aria-expanded="@(_menuAbierto ? "true" : "false")" aria-controls="menu-movil" @onclick="AlternarMenu">
                                    Menú
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <AuthorizeView Roles="Entrenador" Context="menuEntrenador">
                                    <Authorized>
                                        <button type="button" class="btn-barra itm-menu-boton" aria-expanded="@(_menuAbierto ? "true" : "false")" aria-controls="menu-movil" @onclick="AlternarMenu">
                                            Menú
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </NotAuthorized>
                        </AuthorizeView>
                        <button type="button" class="btn-barra" @onclick="CerrarSesion">Cerrar sesión</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="itm-barra__derecha">
                        <a href="login" class="btn-barra">Iniciar sesión</a>
                        <a href="registro" class="btn-barra btn-barra--solido">Registrarse</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Administrador (siempre) y Entrenador (celular): el menú se despliega bajo la barra *@
        <AuthorizeView Roles="Administrador,Entrenador" Context="desplegableContext">
            <Authorized>
                @if (_menuAbierto)
                {
                    <AuthorizeView Roles="Administrador" Context="adminMovil">
                        <Authorized>
                            <nav class="itm-menu-movil itm-menu-movil--siempre" id="menu-movil" aria-label="Menú de administración"><NavMenuAdministrador /></nav>
                        </Authorized>
                        <NotAuthorized>
                            <nav class="itm-menu-movil" id="menu-movil" aria-label="Menú del entrenador"><NavMenuEntrenador /></nav>
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </Authorized>
        </AuthorizeView>
    </header>

    <main id="main-content" class="flex-grow-1 d-flex flex-column">
        @Body
    </main>

    <ContenedorAvisos />

    <footer class="itm-pie">
        <div class="itm-contenedor" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <strong>Bienestar Universitario · Gimnasio</strong>
                <span class="d-none d-sm-inline"> · Institución Universitaria ITM · Medellín, Colombia</span>
            </div>
            <div style="display: flex; gap: 16px; align-items: center; font-size: 13px;">
                <a href="/ayuda" style="color: inherit; text-decoration: underline;">Centro de ayuda</a>
                <a href="/ayuda/reportar" style="color: inherit; text-decoration: underline;">Reportar problema</a>
            </div>
        </div>
    </footer>

    @* Usuario (ni Administrador ni Entrenador) en celular: barra inferior *@
    <AuthorizeView Roles="Administrador,Entrenador" Context="sinTabs">
        <Authorized />
        <NotAuthorized>
            <AuthorizeView Context="conSesion">
                <Authorized><NavTabsUsuario /></Authorized>
            </AuthorizeView>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _menuAbierto;

    protected override void OnInitialized() => NavigationManager.LocationChanged += AlCambiarRuta;

    private void AlternarMenu() => _menuAbierto = !_menuAbierto;

    private void AlCambiarRuta(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_menuAbierto)
        {
            _menuAbierto = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task CerrarSesion()
    {
        _menuAbierto = false;
        await AutenticacionService.CerrarSesionAsync();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose() => NavigationManager.LocationChanged -= AlCambiarRuta;
}
