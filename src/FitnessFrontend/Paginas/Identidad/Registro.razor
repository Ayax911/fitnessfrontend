@* RF-013, RF-025: Registro de nuevos usuarios con perfil y autorización de tratamiento de datos (RNF-011) *@
@page "/registro"
@using FitnessFrontend.Servicios.Identidad
@using FitnessFrontend.Componentes.Compartidos
@using FitnessFrontend.ApiCliente.Models
@inject IAutenticacionService AutenticacionService
@inject NavigationManager NavigationManager

<div class="itm-acceso itm-acceso--registro">
    <PanelBienvenida Titulo="Crea tu cuenta" Texto="Con ella reservas cupo y registras tu asistencia. Tarda un minuto." VolverHref="@ObtenerUrlLogin()" VolverTexto="Volver al inicio de sesión" />
    <div class="itm-acceso__formulario">
        <div>

                    <h2 class="itm-acceso__titulo">Crear cuenta</h2>

                    @if (!string.IsNullOrWhiteSpace(_mensajeError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_mensajeError
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_mensajeExito))
                    {
                        <div class="alert alert-success" role="alert">
                            @_mensajeExito
                        </div>
                    }

                    <EditForm Model="@_modelo" OnValidSubmit="ManejarRegistro">
                        <DataAnnotationsValidator />

                        <div class="itm-campos-fila">
                        <div class="mb-3">
                            <label for="regNombreInput" class="form-label fw-semibold">Nombre completo</label>
                            <InputText id="regNombreInput" class="form-control" @bind-Value="_modelo.NombreCompleto" placeholder="Nombre y apellidos" autocomplete="name" />
                            <ValidationMessage For="@(() => _modelo.NombreCompleto)" class="validation-message" />
                        </div>

                        <div class="mb-3">
                            <label for="regTipoInput" class="form-label fw-semibold">Tipo de usuario</label>
                            <InputSelect id="regTipoInput" class="form-select" @bind-Value="_modelo.TipoUsuario">
                                <option value="">Seleccione...</option>
                                <option value="@TipoUsuario.Estudiante">Estudiante</option>
                                <option value="@TipoUsuario.Profesor">Profesor</option>
                                <option value="@TipoUsuario.Externo">Externo</option>
                                <option value="@TipoUsuario.Contratista">Contratista</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _modelo.TipoUsuario)" class="validation-message" />
                        </div>
                        </div>

                        <div class="mb-3">
                            <label for="regEmailInput" class="form-label fw-semibold">Correo Institucional</label>
                            <InputText id="regEmailInput" class="form-control" @bind-Value="_modelo.Email" placeholder="usuario@correo.itm.edu.co" />
                            <div class="form-text small">Estudiantes y profesores usan el correo institucional.</div>
                            <ValidationMessage For="@(() => _modelo.Email)" class="validation-message" />
                        </div>

                        <div class="itm-campos-fila">
                        <div class="mb-3">
                            <label for="regPasswordInput" class="form-label fw-semibold">Contraseña</label>
                            <InputText id="regPasswordInput" type="password" class="form-control" @bind-Value="_modelo.Password" placeholder="••••••••" />
                            <div class="form-text small">Mínimo 6 caracteres, con mayúscula, minúscula, número y un símbolo.</div>
                            <ValidationMessage For="@(() => _modelo.Password)" class="validation-message" />
                        </div>

                        <div class="mb-4">
                            <label for="regConfirmPasswordInput" class="form-label fw-semibold">Confirmar Contraseña</label>
                            <InputText id="regConfirmPasswordInput" type="password" class="form-control" @bind-Value="_modelo.ConfirmPassword" placeholder="••••••••" />
                            <ValidationMessage For="@(() => _modelo.ConfirmPassword)" class="validation-message" />
                        </div>
                        </div>

                        @* PENDIENTE (RNF-011, validación jurídica): el texto y el enlace oficial del aviso de privacidad
                           no están definidos. La casilla es obligatoria (RF-025); el backend rechaza el registro sin ella. *@
                        <div class="form-check mb-4">
                            <InputCheckbox id="regAutorizacionInput" class="form-check-input" @bind-Value="_modelo.AceptaTratamientoDatos" />
                            <label for="regAutorizacionInput" class="form-check-label small">
                                Autorizo el tratamiento de mis datos personales conforme a la Ley 1581 de 2012.
                            </label>
                            <ValidationMessage For="@(() => _modelo.AceptaTratamientoDatos)" class="text-danger small d-block" />
                        </div>

                        <div class="d-grid gap-2 mb-3 mt-4">
                            <BotonAccion Tipo="submit" 
                                        Clase="btn-itm-primario" 
                                        EstaProcesando="@_procesando" 
                                        TextoProcesando="Creando cuenta...">
                                Crear cuenta
                            </BotonAccion>
                        </div>
                    </EditForm>

                    <p class="itm-acceso__pie">¿Ya tienes cuenta? <a href="@ObtenerUrlLogin()">Inicia sesión</a></p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly RegistroDto _modelo = new();
    private bool _procesando;
    private string? _mensajeError;
    private string? _mensajeExito;

    private string ObtenerUrlLogin()
    {
        return !string.IsNullOrWhiteSpace(ReturnUrl)
            ? $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}"
            : "/login";
    }

    private async Task ManejarRegistro()
    {
        _procesando = true;
        _mensajeError = null;
        _mensajeExito = null;

        var resultado = await AutenticacionService.RegistrarAsync(
            _modelo.Email, _modelo.Password, _modelo.NombreCompleto, _modelo.TipoUsuario!.Value, _modelo.AceptaTratamientoDatos);
        _procesando = false;

        if (resultado.EsExitoso)
        {
            _mensajeExito = "Cuenta creada exitosamente. Redirigiendo a inicio de sesión...";
            await Task.Delay(1500);
            var destinoLogin = !string.IsNullOrWhiteSpace(ReturnUrl)
                ? $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}&registrado=true"
                : "/login?registrado=true";
            NavigationManager.NavigateTo(destinoLogin);
        }
        else
        {
            _mensajeError = resultado.Mensaje ?? "No fue posible crear la cuenta.";
        }
    }

    public class RegistroDto
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre completo es obligatorio.")]
        public string NombreCompleto { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Seleccione el tipo de usuario.")]
        public TipoUsuario? TipoUsuario { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "Debe autorizar el tratamiento de sus datos personales para registrarse.")]
        public bool AceptaTratamientoDatos { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo institucional es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de correo inválido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es obligatoria.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Debe confirmar la contraseña.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
