@* RF-013: Autenticación de usuarios e inicio de sesión *@
@page "/login"
@using FitnessFrontend.Servicios.Identidad
@using FitnessFrontend.Componentes.Compartidos
@inject IAutenticacionService AutenticacionService
@inject NavigationManager NavigationManager

<div class="itm-acceso">
    <PanelBienvenida Titulo="Reserva tu cupo en el gimnasio" Texto="Mira las actividades, reserva y registra tu asistencia con el QR." />
    <div class="itm-acceso__formulario">
        <div>

                    <h2 class="itm-acceso__titulo">Iniciar sesión</h2>

                    @if (!string.IsNullOrWhiteSpace(_mensajeError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_mensajeError
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_mensajeExito))
                    {
                        <div class="alert alert-success" role="alert">
                            @_mensajeExito
                        </div>
                    }

                    <EditForm Model="@_modelo" OnValidSubmit="ManejarLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="emailInput" class="form-label fw-semibold">Correo Institucional</label>
                            <InputText id="emailInput" class="form-control" @bind-Value="_modelo.Email" placeholder="usuario@correo.itm.edu.co" />
                            <ValidationMessage For="@(() => _modelo.Email)" class="validation-message" />
                        </div>

                        <div class="mb-4">
                            <div class="itm-campo__cab">
                                <label for="passwordInput" class="form-label fw-semibold mb-0">Contraseña</label>
                                <button type="button" class="itm-enlace-secundario" aria-controls="passwordInput" aria-pressed="@(_verClave ? "true" : "false")" @onclick="() => _verClave = !_verClave">@(_verClave ? "Ocultar" : "Mostrar")</button>
                            </div>
                            <InputText id="passwordInput" type="@(_verClave ? "text" : "password")" class="form-control" @bind-Value="_modelo.Password" placeholder="••••••••" autocomplete="current-password" />
                            <ValidationMessage For="@(() => _modelo.Password)" class="validation-message" />
                        </div>

                        <div class="d-grid gap-2 mb-3 mt-4">
                            <BotonAccion Tipo="submit" 
                                        Clase="btn-itm-primario" 
                                        EstaProcesando="@_procesando" 
                                        TextoProcesando="Validando credenciales...">
                                Iniciar sesión
                            </BotonAccion>
                        </div>
                    </EditForm>

                    <p class="itm-acceso__pie">¿Aún no tienes cuenta? <a href="@ObtenerUrlRegistro()">Regístrate</a></p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "registrado")]
    public bool? Registrado { get; set; }

    private readonly LoginDto _modelo = new();
    private bool _procesando;
    private bool _verClave;
    private string? _mensajeError;
    private string? _mensajeExito;

    protected override void OnInitialized()
    {
        if (Registrado == true)
        {
            _mensajeExito = "Registro exitoso. Ingrese sus credenciales para continuar.";
        }
    }

    private string ObtenerUrlRegistro()
    {
        return !string.IsNullOrWhiteSpace(ReturnUrl)
            ? $"/registro?returnUrl={Uri.EscapeDataString(ReturnUrl)}"
            : "/registro";
    }

    private async Task ManejarLogin()
    {
        _procesando = true;
        _mensajeError = null;

        var resultado = await AutenticacionService.IniciarSesionAsync(_modelo.Email, _modelo.Password);
        _procesando = false;

        if (resultado.EsExitoso)
        {
            if (!string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.Contains("://") && !ReturnUrl.StartsWith("//"))
            {
                NavigationManager.NavigateTo(ReturnUrl);
            }
            else
            {
                NavigationManager.NavigateTo("/eventos");
            }
        }
        else
        {
            _mensajeError = resultado.Mensaje ?? "Credenciales inválidas.";
        }
    }

    public class LoginDto
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de correo inválido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
