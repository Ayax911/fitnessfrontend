@* RF-021: Consultar su propio historial de asistencias (Usuario) *@
@page "/mi-historial"
@page "/historial"
@attribute [Authorize]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Asistencia
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IAsistenciaClienteService AsistenciaService
@inject IZonaHorariaService ZonaHoraria

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Mi asistencia</h1>
            <p>Registro de ingresos al gimnasio y participación en sesiones.</p>
        </div>
    </div>

    @* Patrón 5: DTO HistorialAsistenciaDto no expone nivel ni confiabilidad (RN-020) *@
    <EstadoDeCarga Estado="@_estado" AlReintentar="CargarHistorial" MensajeCargando="Cargando su historial de asistencias...">
        <CargandoTemplate>
            <EsqueletoLista Cantidad="5" Mensaje="Cargando su historial de asistencias..." />
        </CargandoTemplate>
        <ExitoTemplate Context="historial">
            @if (historial.Count == 0)
            {
                <div class="itm-vacio">
                    <h2>No tienes asistencias registradas</h2>
                    <p>Aún no has registrado ingresos generales ni asistencias a sesiones.</p>
                </div>
            }
            else
            {
                <p class="itm-lista__aparte mb-2">Total de registros: @historial.Count</p>
                <ul class="itm-lista">
                    @foreach (var item in historial)
                    {
                        var esSesion = string.Equals(item.Tipo, "Sesion", StringComparison.OrdinalIgnoreCase);
                        <li @key="item.Id">
                            <div>
                                <p class="itm-lista__hora">@(item.FechaHora.HasValue ? ZonaHoraria.FormatearFechaHora(item.FechaHora.Value) : "—")</p>
                                <p class="itm-lista__nombre">@(string.IsNullOrWhiteSpace(item.NombreEvento) ? "Ingreso Gimnasio" : item.NombreEvento)</p>
                                <p class="itm-lista__aparte">@(esSesion ? "Sesión Deportiva" : "Ingreso General")</p>
                            </div>
                            <InsigniaEstado Tipo="@(esSesion ? "asistida" : "ingreso")">@(item.Estado ?? "Registrado")</InsigniaEstado>
                        </li>
                    }
                </ul>
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@code {
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<HistorialAsistenciaDto>>? _estado;

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorial();
    }

    private async Task CargarHistorial()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<HistorialAsistenciaDto>>.Cargando();
        _estado = await AsistenciaService.ObtenerHistorialAsync();
    }
}
