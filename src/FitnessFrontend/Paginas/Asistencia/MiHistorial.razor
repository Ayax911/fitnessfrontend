@* RF-021: Consultar su propio historial de asistencias (Usuario) *@
@page "/mi-historial"
@page "/historial"
@attribute [Authorize]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Asistencia
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IAsistenciaClienteService AsistenciaService
@inject IZonaHorariaService ZonaHoraria

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Mi asistencia</h1>
            <p>Tus ingresos al gimnasio y tu asistencia a las actividades.</p>
        </div>
    </div>

    @* Patrón 5: DTO HistorialAsistenciaDto no expone nivel ni confiabilidad (RN-020) *@
    <EstadoDeCarga Estado="@_estado" AlReintentar="CargarHistorial" MensajeCargando="Cargando su historial de asistencias...">
        <CargandoTemplate>
            <EsqueletoLista Cantidad="5" Mensaje="Cargando su historial de asistencias..." />
        </CargandoTemplate>
        <ExitoTemplate Context="historial">
            @if (historial.Count == 0)
            {
                <div class="itm-vacio">
                    <h2>No tienes asistencias registradas</h2>
                    <p>Aún no has registrado ingresos generales ni asistencias a sesiones.</p>
                </div>
            }
            else
            {
                // Agrupado por día (más reciente primero), como en el diseño "Mi asistencia"
                var grupos = historial
                    .Where(h => h.FechaHora.HasValue)
                    .Select(h => (Item: h, Local: ZonaHoraria.AHoraLocal(h.FechaHora!.Value).DateTime))
                    .GroupBy(x => x.Local.Date)
                    .OrderByDescending(g => g.Key);

                @foreach (var grupo in grupos)
                {
                    <h2 class="itm-seccion">@PresentacionFechas.FechaLarga(grupo.Key)</h2>
                    <ul class="itm-filas itm-filas--asistencia">
                        @foreach (var (item, local) in grupo.OrderByDescending(x => x.Local))
                        {
                            var esSesion = string.Equals(item.Tipo, "Sesion", StringComparison.OrdinalIgnoreCase);
                            var (tipoInsignia, textoInsignia) = Insignia(item, esSesion);
                            <li class="itm-fila" @key="item.Id">
                                <div class="itm-fila__cuando">
                                    <p class="itm-fila__hora">@PresentacionFechas.Hora(local)<span class="itm-fila__ampm">@PresentacionFechas.Meridiano(local)</span></p>
                                </div>
                                <div class="itm-fila__cuerpo">
                                    <p class="itm-fila__tipo">@(esSesion ? "Sesión" : "Ingreso general")</p>
                                    <p class="itm-fila__nombre">@(string.IsNullOrWhiteSpace(item.NombreEvento) ? (esSesion ? "Sesión" : "Ingreso al gimnasio") : item.NombreEvento)</p>
                                    <div class="itm-fila__estado"><InsigniaEstado Tipo="@tipoInsignia">@textoInsignia</InsigniaEstado></div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@code {
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<HistorialAsistenciaDto>>? _estado;

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorial();
    }

    // Estado del registro tal como lo informa el backend; solo se elige cómo mostrarlo
    private static (string Tipo, string Texto) Insignia(HistorialAsistenciaDto item, bool esSesion)
    {
        if (!esSesion) return ("ingreso", "Ingreso registrado");
        var estado = item.Estado ?? string.Empty;
        return estado.Contains("No", StringComparison.OrdinalIgnoreCase) ? ("no", "No asistida") : ("asistida", "Asistida");
    }

    private async Task CargarHistorial()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<HistorialAsistenciaDto>>.Cargando();
        _estado = await AsistenciaService.ObtenerHistorialAsync();
    }
}
