@* RF-006: Registrar ingreso general por torniquete o punto de acceso *@
@page "/ingreso/{IdPuntoAcceso}"
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Asistencia
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IAsistenciaClienteService AsistenciaService
@inject IZonaHorariaService ZonaHoraria
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="itm-contenedor itm-pagina">
    @if (_evaluando)
    {
        <div class="itm-resultado" role="status" aria-busy="true">
                <span class="itm-solo-lectores">Comprobando credenciales de acceso...</span>
                <span class="itm-esq" aria-hidden="true" style="width: 88px; height: 88px; border-radius: 999px;"></span>
                <span class="itm-esq itm-esq--titulo" aria-hidden="true" style="width: 60%;"></span>
                <span class="itm-esq itm-esq--linea" aria-hidden="true" style="width: 80%;"></span>
            </div>
    }
    else
    {
        <EstadoDeCarga Estado="@_estado" AlReintentar="RegistrarIngreso" MensajeCargando="Validando acceso en torniquete...">
            <CargandoTemplate>
                <div class="itm-resultado" role="status" aria-busy="true">
                <span class="itm-solo-lectores">Validando acceso en torniquete...</span>
                <span class="itm-esq" aria-hidden="true" style="width: 88px; height: 88px; border-radius: 999px;"></span>
                <span class="itm-esq itm-esq--titulo" aria-hidden="true" style="width: 60%;"></span>
                <span class="itm-esq itm-esq--linea" aria-hidden="true" style="width: 80%;"></span>
            </div>
            </CargandoTemplate>
            <ErrorTemplate Context="error">
                <div class="itm-resultado">
                    <span class="itm-resultado__sello itm-resultado__sello--error"><svg class="itm-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg></span>
                    <h1>No se pudo registrar el ingreso</h1>
                    @* RN-030: el rechazo del backend se muestra tal cual; sin cuenta regresiva ni explicación propia *@
                    <div class="alert alert-danger w-100 text-start" role="alert">@error.Mensaje</div>
                    <button type="button" class="btn btn-itm-secundario itm-btn-bloque" @onclick="RegistrarIngreso">Reintentar</button>
                </div>
            </ErrorTemplate>
            <ExitoTemplate Context="resultado">
                <div class="itm-resultado">
                    <span class="itm-resultado__sello itm-resultado__sello--ok"><svg class="itm-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <h1>¡Ingreso Autorizado!</h1>
                    <p>@(resultado.Mensaje ?? "Acceso concedido exitosamente.")</p>

                    @* Se muestra el NOMBRE del punto que devuelve el backend; el identificador de la URL es el token del QR y no se enseña *@
                    @if (!string.IsNullOrWhiteSpace(resultado.Detalle))
                    {
                        <dl class="itm-datos"><dt>Punto de acceso</dt><dd>@resultado.Detalle</dd></dl>
                    }

                    <a href="/eventos" class="btn btn-itm-primario itm-btn-bloque">Ver actividades del día</a>
                </div>
            </ExitoTemplate>
        </EstadoDeCarga>
    }
</div>

@code {
    [Parameter]
    public string IdPuntoAcceso { get; set; } = string.Empty;

    private bool _evaluando = true;
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<CheckInResultadoDto>? _estado;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var estaAutenticado = authState.User.Identity?.IsAuthenticated ?? false;

        if (!estaAutenticado)
        {
            _evaluando = false;
            var returnUrl = $"/ingreso/{Uri.EscapeDataString(IdPuntoAcceso)}";
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            return;
        }

        _evaluando = false;
        await RegistrarIngreso();
    }

    private async Task RegistrarIngreso()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<CheckInResultadoDto>.Cargando();
        // RN-030: Si el backend rechaza por intervalo mínimo, el rechazo viene en el EstadoDeCarga y se muestra tal cual
        _estado = await AsistenciaService.RegistrarIngresoGeneralAsync(IdPuntoAcceso);
    }
}
