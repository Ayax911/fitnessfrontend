@* RF-024, RN-005: Gestión de puntos de acceso y QR fijo de ingreso general (Administrador) *@
@page "/admin/puntos-acceso"
@attribute [Authorize(Roles = "Administrador")]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Asistencia
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IPuntosAccesoClienteService PuntosService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="h2 fw-bold mb-1"><span class="bi bi-qr-code me-2"></span>Puntos de acceso</h1>
        <p class="text-muted mb-0">
            Cada punto de acceso del gimnasio tiene una pantalla con un código QR que cambia cada pocos segundos para registrar el ingreso de forma segura.
        </p>
    </div>

    <div class="card card-itm shadow-sm mb-4">
        <div class="card-body p-4">
            <form @onsubmit="Crear" @onsubmit:preventDefault class="row g-3 align-items-end">
                <div class="col-12 col-md-8">
                    <label for="nombrePuntoNuevo" class="form-label fw-semibold">Nuevo punto de acceso</label>
                    <input id="nombrePuntoNuevo" class="form-control" @bind="_nombreNuevo" @bind:event="oninput" maxlength="100" placeholder="Ej. Recepción principal" />
                </div>
                <div class="col-12 col-md-4 d-grid">
                    <BotonAccion Tipo="submit" Clase="btn-itm-primario" EstaProcesando="@_procesando" TextoProcesando="Creando...">
                        <span class="bi bi-plus-circle me-1"></span>Crear punto
                    </BotonAccion>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert @(_mensajeEsExito ? "alert-success" : "alert-danger")" role="alert" aria-live="polite">@_mensaje</div>
    }

    <EstadoDeCarga Estado="@_estado" AlReintentar="Cargar" MensajeCargando="Cargando puntos de acceso...">
        <ExitoTemplate Context="puntos">
            @if (puntos.Count == 0)
            {
                <div class="text-center py-5 text-muted">Aún no hay puntos de acceso. Cree el primero arriba.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <caption class="visually-hidden">Puntos de acceso del gimnasio</caption>
                        <thead>
                            <tr>
                                <th scope="col">Nombre</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in puntos)
                            {
                                <tr>
                                    <td>
                                        @if (_renombrandoId == p.Id)
                                        {
                                            <input class="form-control form-control-sm" aria-label="Nuevo nombre" @bind="_nombreEdicion" @bind:event="oninput" maxlength="100" />
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">@p.Nombre</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(p.Activo == true ? "text-bg-success" : "text-bg-secondary")">@(p.Activo == true ? "Activo" : "Desactivado")</span>
                                    </td>
                                    <td class="text-end">
                                        @if (_renombrandoId == p.Id)
                                        {
                                            <button type="button" class="btn btn-sm btn-itm-primario me-1" @onclick="() => GuardarNombre(p)" disabled="@_procesando">Guardar</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarRenombrar">Cancelar</button>
                                        }
                                        else
                                        {
                                            <a href="@($"/admin/puntos-acceso/{p.Id}/pantalla")" target="_blank" class="btn btn-sm btn-outline-primary me-1">Abrir pantalla</a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => IniciarRenombrar(p)">Renombrar</button>
                                            <button type="button" class="btn btn-sm @(p.Activo == true ? "btn-outline-danger" : "btn-outline-success")"
                                                    @onclick="() => AlternarActivo(p)" disabled="@_procesando">
                                                @(p.Activo == true ? "Desactivar" : "Activar")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@code {
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<List<PuntoAccesoDto>>? _estado;
    private string _nombreNuevo = string.Empty;
    private string _nombreEdicion = string.Empty;
    private Guid? _renombrandoId;
    private bool _procesando;
    private string? _mensaje;
    private bool _mensajeEsExito;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<List<PuntoAccesoDto>>.Cargando();
        _estado = await PuntosService.ListarAsync();
    }

    private async Task Crear()
    {
        _mensaje = null;
        _procesando = true;
        var r = await PuntosService.CrearAsync(_nombreNuevo);
        _procesando = false;

        Notificar(r.EsExito, r.EsExito ? "Punto de acceso creado." : r.MensajeError);
        if (r.EsExito)
        {
            _nombreNuevo = string.Empty;
            await Cargar();
        }
    }

    private void IniciarRenombrar(PuntoAccesoDto p)
    {
        _renombrandoId = p.Id;
        _nombreEdicion = p.Nombre ?? string.Empty;
    }

    private void CancelarRenombrar() => _renombrandoId = null;

    private async Task GuardarNombre(PuntoAccesoDto p) => await Actualizar(p, _nombreEdicion, p.Activo == true, "Nombre actualizado.");

    private async Task AlternarActivo(PuntoAccesoDto p) =>
        await Actualizar(p, p.Nombre ?? string.Empty, p.Activo != true, p.Activo == true ? "Punto desactivado." : "Punto activado.");

    private async Task Actualizar(PuntoAccesoDto p, string nombre, bool activo, string exito)
    {
        _mensaje = null;
        _procesando = true;
        var r = await PuntosService.ActualizarAsync(p.Id!.Value, nombre, activo);
        _procesando = false;

        Notificar(r.EsExito, r.EsExito ? exito : r.MensajeError);
        if (r.EsExito)
        {
            _renombrandoId = null;
            await Cargar();
        }
    }

    private void Notificar(bool exito, string? mensaje)
    {
        _mensajeEsExito = exito;
        _mensaje = mensaje;
    }
}
