@* RF-004: Cancelar una reserva activa *@
@* RF-020: Consultar sus propias reservas *@
@* RF-028: Notificación dentro de la app de sesión cancelada con motivo de la organización *@
@* RF-029: Anuncios a inscritos en la app *@
@* RF-036: Agregar una reserva al calendario personal (.ics) *@
@page "/reservas"
@attribute [Authorize]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Reservas
@using FitnessFrontend.Servicios.Calendario
@using FitnessFrontend.Servicios.Eventos
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IReservasClienteService ReservasService
@inject INotasYAnunciosClienteService NotasAnunciosService
@inject IZonaHorariaService ZonaHoraria
@inject IJSRuntime JS
@inject IAvisosService Avisos

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Mis reservas</h1>
            <p>Consulta tus reservas activas, lista de espera y cancelaciones.</p>
        </div>
        <button class="btn btn-itm-secundario btn-sm" @onclick="CargarReservas" disabled="@(_estado?.EsCargando == true)">
            Actualizar
        </button>
    </div>

    <EstadoDeCarga Estado="@_estado" AlReintentar="CargarReservas" MensajeCargando="Cargando tus reservas...">
        <CargandoTemplate>
            <EsqueletoLista Cantidad="4" Mensaje="Cargando tus reservas..." />
        </CargandoTemplate>
        <ExitoTemplate Context="reservas">
            @if (reservas.Count == 0)
            {
                <div class="itm-vacio">
                    <h2>No tienes reservas registradas</h2>
                    <p>Aún no te has inscrito en ninguna actividad del gimnasio.</p>
                    <a href="/eventos" class="btn btn-itm-primario mt-2">Explorar actividades</a>
                </div>
            }
            else
            {
                var hoy = ZonaHoraria.ObtenerFechaHoyLocal().Date;
                var ahora = DateTimeOffset.UtcNow;
                // Próximas: activas (confirmada o en espera), sin cancelar por la organización y que aún no terminan
                var proximas = reservas
                    .Where(r => EsProxima(r, ahora))
                    .OrderBy(r => r.FechaHoraInicio).ToList();
                var anteriores = reservas
                    .Where(r => !EsProxima(r, ahora))
                    .OrderByDescending(r => r.FechaHoraInicio).ToList();

                // Una reserva: hora a la izquierda; actividad, entrenador y ubicación; estado; y la acción de cancelar (diseño del artifact)
                RenderFragment<(ReservaResumenDto Reserva, bool ConAcciones)> fila = dato => @<li class="itm-fila" @key="dato.Reserva.Id">
                    @{
                        var reserva = dato.Reserva;
                        var sesionId = reserva.SesionEventoId ?? Guid.Empty;
                        var esSesionCancelada = reserva.SesionCancelada == true || reserva.OrigenCancelacion == "SesionCancelada";
                        // PENDIENTE (RN-011 pendiente): si la sesión fue cancelada por la organización, no se permite cancelar por el usuario
                        var esCancelable = dato.ConAcciones && !esSesionCancelada && (reserva.Estado == 0 || reserva.Estado == 1);
                        var cancelandoEsta = _cancelandoReservaId == reserva.Id;
                        var inicioLocal = reserva.FechaHoraInicio.HasValue ? ZonaHoraria.AHoraLocal(reserva.FechaHoraInicio.Value).DateTime : (DateTime?)null;
                    }
                    <div class="itm-fila__cuando">
                        @if (inicioLocal.HasValue)
                        {
                            <p class="itm-fila__dia">@PresentacionFechas.DiaCorto(inicioLocal.Value, hoy)</p>
                            <p class="itm-fila__hora">@PresentacionFechas.Hora(inicioLocal.Value)<span class="itm-fila__ampm">@PresentacionFechas.Meridiano(inicioLocal.Value)</span></p>
                        }
                        else
                        {
                            <p class="itm-fila__hora">—</p>
                        }
                    </div>
                    <div class="itm-fila__cuerpo">
                        <div>
                            <p class="itm-fila__nombre">@(reserva.EventoNombre ?? "Actividad de gimnasio")</p>
                            @if (!string.IsNullOrWhiteSpace(reserva.EntrenadorNombre))
                            {
                                <p class="itm-fila__quien">@reserva.EntrenadorNombre</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(reserva.EventoUbicacion))
                            {
                                <p class="itm-fila__quien">@reserva.EventoUbicacion</p>
                            }

                            @* RF-028: Motivo de la sesión cancelada por la organización (RN-020: sin nivel ni penalización) *@
                            @if (esSesionCancelada)
                            {
                                <div class="alert alert-warning py-1 px-2 my-2" role="note" style="font-size: 12px;">
                                    <strong>Sesión cancelada por la organización:</strong>
                                    @(string.IsNullOrWhiteSpace(reserva.MotivoCancelacion) ? "Por motivos operativos del centro deportivo." : reserva.MotivoCancelacion)
                                </div>
                            }

                            @* RF-029: Anuncios vigentes de la sesión *@
                            @if (_anunciosPorSesion.TryGetValue(sesionId, out var avisos) && avisos.Count > 0)
                            {
                                <div class="p-2 my-2 rounded" style="background: #eef5fc; border-left: 3px solid var(--azul-itm); font-size: 12px;">
                                    <div class="fw-bold text-dark mb-1">Aviso de la sesión:</div>
                                    @foreach (var aviso in avisos)
                                    {
                                        <p class="mb-0 text-dark" style="white-space: pre-wrap;">@aviso.Mensaje</p>
                                    }
                                </div>
                            }
                        </div>
                        <div class="itm-fila__estado">@ObtenerBadgeEstado(reserva, esSesionCancelada)</div>
                        <div class="itm-fila__accion">
                            @* RF-036: Agregar a mi calendario (.ics) *@
                            @if (reserva.Estado == 0 && !esSesionCancelada && dato.ConAcciones && reserva.FechaHoraInicio.HasValue && reserva.FechaHoraFin.HasValue)
                            {
                                <button type="button" class="itm-enlace-secundario" @onclick="@(() => DescargarIcs(reserva))" aria-label="Agregar a mi calendario">Agregar a mi calendario</button>
                            }
                            @if (esCancelable)
                            {
                                <button type="button" class="itm-cancelar" disabled="@cancelandoEsta" @onclick="@(() => PedirCancelacion(reserva))">Cancelar reserva</button>
                            }
                        </div>
                    </div>
                </li>;

                <h2 class="itm-seccion">Próximas</h2>
                @if (proximas.Count == 0)
                {
                    <div class="itm-vacio" style="margin-bottom: var(--space-5);">
                        <h2>No tienes reservas próximas</h2>
                        <p>Reserva tu cupo en una actividad.</p>
                        <a href="/eventos" class="btn btn-itm-primario mt-2">Ver actividades</a>
                    </div>
                }
                else
                {
                    <ul class="itm-filas itm-filas--reservas">
                        <li class="itm-filas__cab" aria-hidden="true" style="grid-template-columns: 140px minmax(0, 1fr) 210px 170px;"><span>Cuándo</span><span>Actividad</span><span>Estado</span><span>Acción</span></li>
                        @foreach (var reserva in proximas)
                        {
                            @fila((reserva, true))
                        }
                    </ul>
                }

                @if (anteriores.Count > 0)
                {
                    <h2 class="itm-seccion">Anteriores</h2>
                    <ul class="itm-filas itm-filas--reservas">
                        <li class="itm-filas__cab" aria-hidden="true" style="grid-template-columns: 140px minmax(0, 1fr) 210px 170px;"><span>Cuándo</span><span>Actividad</span><span>Estado</span><span></span></li>
                        @foreach (var reserva in anteriores)
                        {
                            @fila((reserva, false))
                        }
                    </ul>
                }
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@* Confirmación antes de cancelar (diseño del artifact "Confirmar cancelación") *@
<DialogoConfirmacion Abierto="@(_pendiente != null)"
                     IdBase="cancelar-reserva"
                     Titulo="¿Cancelar tu reserva?"
                     Datos="@(_pendiente == null ? null : new List<DatoAviso> { new("Actividad", _pendiente.Actividad), new("Cuándo", _pendiente.Cuando) })"
                     Mensaje="@(_pendiente?.EnEspera == true ? "Si cancelas, saldrás de la lista de espera." : "Si cancelas, tu cupo queda libre para otra persona.")"
                     TextoConfirmar="Sí, cancelar reserva"
                     TextoCancelar="No, mantener mi reserva"
                     TextoProcesando="Cancelando..."
                     Peligro="true"
                     Procesando="@(_cancelandoReservaId.HasValue)"
                     OnConfirmar="ConfirmarCancelacion"
                     OnCancelar="DescartarCancelacion" />

@code {
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<ReservaResumenDto>>? _estado;
    private Dictionary<Guid, List<FitnessFrontend.Servicios.Eventos.AnuncioSesionDto>> _anunciosPorSesion = new();
    private Guid? _cancelandoReservaId;

    protected override async Task OnInitializedAsync()
    {
        await CargarReservas();
    }

    private async Task CargarReservas()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<ReservaResumenDto>>.Cargando();
        _estado = await ReservasService.ObtenerMisReservasAsync();

        if (_estado.EsExito && _estado.Valor != null)
        {
            var resAnuncios = await NotasAnunciosService.ObtenerAnunciosMisReservasAsync();
            if (resAnuncios.EsExito && resAnuncios.Valor != null)
            {
                _anunciosPorSesion = resAnuncios.Valor
                    .GroupBy(a => a.SesionId)
                    .ToDictionary(g => g.Key, g => g.ToList());
            }
        }
    }

    private string CuandoTexto(ReservaResumenDto reserva)
    {
        if (!reserva.FechaHoraInicio.HasValue) return string.Empty;
        var inicio = ZonaHoraria.AHoraLocal(reserva.FechaHoraInicio.Value).DateTime;
        var texto = $"{PresentacionFechas.FechaCorta(inicio)}, {PresentacionFechas.HoraCompleta(inicio)}";
        if (reserva.FechaHoraFin.HasValue)
            texto += $" – {PresentacionFechas.HoraCompleta(ZonaHoraria.AHoraLocal(reserva.FechaHoraFin.Value).DateTime)}";
        return texto;
    }

    private sealed record CancelacionPendiente(Guid ReservaId, string Actividad, string Cuando, bool EnEspera);
    private CancelacionPendiente? _pendiente;

    // Próxima = activa (confirmada o en espera), no cancelada por la organización y todavía no terminó
    private static bool EsProxima(ReservaResumenDto r, DateTimeOffset ahora)
    {
        var activa = r.Estado is 0 or 1;
        var cancelada = r.SesionCancelada == true || r.OrigenCancelacion == "SesionCancelada";
        var fin = r.FechaHoraFin ?? r.FechaHoraInicio ?? DateTimeOffset.MinValue;
        return activa && !cancelada && fin >= ahora;
    }

    private void PedirCancelacion(ReservaResumenDto reserva) =>
        _pendiente = new CancelacionPendiente(reserva.Id ?? Guid.Empty, reserva.EventoNombre ?? string.Empty, CuandoTexto(reserva), reserva.Estado == 1);

    private void DescartarCancelacion() => _pendiente = null;

    private async Task ConfirmarCancelacion()
    {
        if (_pendiente == null) return;
        var p = _pendiente;
        await CancelarReserva(p.ReservaId, p.Actividad, p.Cuando);
        _pendiente = null;
    }

    private async Task CancelarReserva(Guid reservaId, string actividad, string cuando)
    {
        if (reservaId == Guid.Empty) return;

        _cancelandoReservaId = reservaId;

        var resultado = await ReservasService.CancelarReservaAsync(reservaId);
        _cancelandoReservaId = null;

        if (resultado.EsExitoso)
        {
            Avisos.Exito("Reserva cancelada", "Se canceló tu reserva correctamente.", datos: new List<DatoAviso> { new("Actividad", actividad), new("Cuándo", cuando) });
            await CargarReservas();
        }
        else
        {
            Avisos.Error("No se pudo cancelar", resultado.Mensaje ?? "No fue posible cancelar la reserva.", new List<DatoAviso> { new("Actividad", actividad), new("Cuándo", cuando) });
        }
    }

    private RenderFragment ObtenerBadgeEstado(ReservaResumenDto reserva, bool esSesionCancelada) => builder =>
    {
        if (esSesionCancelada)
        {
            builder.OpenComponent<InsigniaEstado>(0);
            builder.AddAttribute(1, nameof(InsigniaEstado.Tipo), "cancelada");
            builder.AddAttribute(2, nameof(InsigniaEstado.ChildContent), (RenderFragment)(b => b.AddContent(0, "Sesión cancelada")));
            builder.CloseComponent();
            return;
        }

        // 0: Confirmada, 1: EnListaEspera, 2: Cancelada, 3: Asistida, 4: NoAsistida, 5: NoAdjudicada
        var (tipo, texto) = reserva.Estado switch
        {
            0 => ("ok", "Reserva confirmada"),
            1 => ("espera", "En lista de espera"),
            2 => ("cancelada", "Cancelada"),
            3 => ("asistida", "Asistida"),
            4 => ("no", "No asistida"),
            _ => ("cancelada", "Finalizada")
        };
        builder.OpenComponent<InsigniaEstado>(0);
        builder.AddAttribute(1, nameof(InsigniaEstado.Tipo), tipo);
        builder.AddAttribute(2, nameof(InsigniaEstado.ChildContent), (RenderFragment)(b => b.AddContent(0, texto)));
        builder.CloseComponent();
    };

    private async Task DescargarIcs(ReservaResumenDto reserva)
    {
        if (!reserva.FechaHoraInicio.HasValue || !reserva.FechaHoraFin.HasValue) return;

        var datos = new GeneradorIcs.DatosEventoIcs(
            reserva.Id ?? Guid.NewGuid(),
            reserva.EventoNombre ?? "Actividad de Gimnasio ITM",
            reserva.FechaHoraInicio.Value,
            reserva.FechaHoraFin.Value,
            "Reserva confirmada en el Gimnasio ITM (Bienestar Universitario)",
            "Gimnasio ITM");

        var ics = GeneradorIcs.Generar(datos);
        var nombreArchivo = $"reserva-{reserva.Id ?? Guid.NewGuid():N}.ics";
        await JS.InvokeVoidAsync("itmDescarga.descargarTexto", nombreArchivo, "text/calendar;charset=utf-8", ics);
    }
}
