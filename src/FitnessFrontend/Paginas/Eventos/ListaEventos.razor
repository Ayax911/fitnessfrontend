@* RF-001: Listar eventos y actividades disponibles en el gimnasio *@
@* RF-002: Reservar cupo en una sesión *@
@* RF-003: Ubicación automática en lista de espera si el cupo está agotado *@
@page "/eventos"
@attribute [Authorize]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Eventos
@using FitnessFrontend.Servicios.Reservas
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@using Microsoft.AspNetCore.Components.Authorization
@inject IEventosClienteService EventosService
@inject IReservasClienteService ReservasService
@inject IZonaHorariaService ZonaHoraria
@inject IAvisosService Avisos

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Actividades</h1>
            <p>Elige un día y reserva tu cupo.</p>
        </div>
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <div class="btn-group" role="group" aria-label="Modo de visualización">
                <a href="/eventos" class="btn btn-itm-primario btn-sm" aria-current="page">Lista</a>
                <a href="/programacion" class="btn btn-itm-secundario btn-sm">Semana</a>
            </div>
            <button class="btn btn-itm-secundario btn-sm" @onclick="CargarEventos" disabled="@(_estado?.EsCargando == true)">
                Actualizar
            </button>
        </div>
    </div>

    <EstadoDeCarga Estado="@_estado" AlReintentar="CargarEventos" MensajeCargando="Cargando actividades disponibles...">
        <CargandoTemplate>
            @* Esqueleto: conserva la jerarquía (selector de día, hora, título, cupo, botón) mientras llegan los datos *@
            <div class="itm-chips" aria-hidden="true"><span class="itm-esq itm-esq--chip"></span><span class="itm-esq itm-esq--chip"></span><span class="itm-esq itm-esq--chip"></span></div>
            <EsqueletoTarjetas Cantidad="6" Mensaje="Cargando actividades disponibles..." />
        </CargandoTemplate>
        <ExitoTemplate Context="eventos">
            @{
                var hoy = ZonaHoraria.ObtenerFechaHoyLocal().Date;
                var sesiones = ObtenerSesiones(eventos);
                var dias = sesiones.Select(x => ZonaHoraria.AHoraLocal(x.Sesion.FechaHoraInicio!.Value).Date).Distinct().OrderBy(d => d).Take(7).ToList();
                var visibles = _diaSeleccionado == null ? sesiones : sesiones.Where(x => ZonaHoraria.AHoraLocal(x.Sesion.FechaHoraInicio!.Value).Date == _diaSeleccionado).ToList();
            }
            @if (eventos.Count == 0)
            {
                <div class="itm-vacio">
                    <h2>No hay actividades programadas</h2>
                    <p>En este momento no hay eventos disponibles para reserva. Por favor consulta más tarde.</p>
                </div>
            }
            else
            {
                @if (dias.Count > 1)
                {
                    <div class="itm-chips" role="group" aria-label="Día">
                        <button type="button" class="itm-chip" aria-pressed="@(_diaSeleccionado == null ? "true" : "false")" @onclick="() => SeleccionarDia(null)">Todos</button>
                        @foreach (var dia in dias)
                        {
                            var d = dia;
                            var chip = PresentacionFechas.Chip(d, hoy);
                            <button type="button" class="itm-chip" aria-pressed="@(_diaSeleccionado == d ? "true" : "false")" @onclick="() => SeleccionarDia(d)">@chip.Etiqueta<small>@chip.Sub</small></button>
                        }
                    </div>
                }

                @if (visibles.Count == 0)
                {
                    <div class="itm-vacio">
                        <h2>No hay actividades este día</h2>
                        <p>Prueba con otro día de la fila de arriba.</p>
                    </div>
                }
                else
                {
                    <div class="itm-rejilla">
                        @foreach (var item in visibles.Take(_limite))
                        {
                            var evento = item.Evento;
                            var sesion = item.Sesion;
                            var sesionId = sesion.Id ?? Guid.Empty;
                            var inicio = ZonaHoraria.AHoraLocal(sesion.FechaHoraInicio!.Value).DateTime;
                            var fin = sesion.FechaHoraFin.HasValue ? ZonaHoraria.AHoraLocal(sesion.FechaHoraFin.Value).DateTime : (DateTime?)null;
                            var estaBloqueadaPorVentana = _sesionesVentanaCerrada.Contains(sesionId);
                            var estaProcesandoEsta = _sesionEnProcesoId == sesionId;
                            var libres = Math.Max(0, sesion.CuposDisponibles ?? 0);
                            var hayCupo = libres > 0;
                            var miEstado = _misReservas.TryGetValue(sesionId, out var estadoPropio) ? estadoPropio : (int?)null;

                            <article class="itm-tarjeta" @key="sesionId">
                                <div class="itm-tarjeta__cab">
                                    <div>
                                        <p class="itm-tarjeta__hora"><span class="itm-nobr">@PresentacionFechas.HoraCompleta(inicio)</span></p>
                                        <p class="itm-tarjeta__fecha">
                                            @if (fin.HasValue)
                                            {
                                                <span>hasta @PresentacionFechas.HoraCompleta(fin.Value)</span>
                                            }
                                            @if (_diaSeleccionado == null)
                                            {
                                                <span> · @PresentacionFechas.DiaCorto(inicio, hoy)@(evento.EsRecurrente == true ? " · Recurrente" : "")</span>
                                            }
                                        </p>
                                    </div>
                                    @if (miEstado == 0)
                                    {
                                        <InsigniaEstado Tipo="ok">Reserva confirmada</InsigniaEstado>
                                    }
                                    else if (miEstado == 1)
                                    {
                                        <InsigniaEstado Tipo="espera">En lista de espera</InsigniaEstado>
                                    }
                                </div>
                                <div>
                                    <h2 class="itm-tarjeta__titulo" title="@evento.Nombre" style="margin-bottom: 4px;">@evento.Nombre</h2>
                                    <p class="itm-meta itm-meta--icono">
                                        <svg class="itm-icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" /><path d="M4 21c0-4.5 3.5-7 8-7s8 2.5 8 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                        <span>@(evento.EntrenadorNombre ?? "Por asignar")</span>
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(evento.Ubicacion))
                                    {
                                        <p class="itm-meta itm-meta--icono">
                                            <svg class="itm-icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                            <span>@evento.Ubicacion</span>
                                        </p>
                                    }
                                    @* I-08 / RN-020 / AMB-014: No se muestra la fecha base de apertura de reservas públicamente
                                       para evitar que usuarios con ventana desplazada deduzcan su condición personal. *@
                                </div>

                                <div class="itm-tarjeta__pie">
                                    @* Cupo: el número va siempre en texto; la barra solo refuerza. Lo informa el backend (no se reimplementa ninguna regla de cupo). *@
                                    <div class="itm-cupo">
                                        <div class="itm-cupo__barra" aria-hidden="true"><span style="width: @PorcentajeOcupado(sesion)%"></span></div>
                                        <span class="itm-cupo__texto"><strong>@libres</strong> de @(sesion.CupoMaximo ?? libres) cupos libres</span>
                                    </div>

                                    @if (miEstado is 0 or 1)
                                    {
                                        <a class="btn btn-itm-secundario itm-btn-bloque" href="/reservas">Ver en mis reservas</a>
                                    }
                                    else if (estaBloqueadaPorVentana)
                                    {
                                        @* PENDIENTE (AMB-014): mensaje genérico neutro mientras el stakeholder no defina
                                           si debe mostrarse un texto explicativo o simplemente ocultarse la acción.
                                           No añadir motivo, nivel ni fecha estimada — violaría RN-020. *@
                                        <button type="button" class="btn btn-itm-primario itm-btn-bloque" disabled>Reservas aún no disponibles</button>
                                    }
                                    else
                                    {
                                        <BotonAccion Tipo="button"
                                                     Clase="btn-itm-primario itm-btn-bloque"
                                                     Deshabilitado="@_sesionEnProcesoId.HasValue"
                                                     EstaProcesando="@estaProcesandoEsta"
                                                     TextoProcesando="Reservando..."
                                                     OnClick="@(() => RealizarReserva(sesionId, evento.Nombre ?? string.Empty, CuandoTexto(sesion)))">
                                            Reservar cupo
                                        </BotonAccion>
                                        @if (!hayCupo)
                                        {
                                            <p class="itm-ayuda">Si no hay cupo, quedas en la lista de espera.</p>
                                        }
                                    }
                                </div>

                                @* El Administrador puede gestionar cualquier sesión y evento desde aquí *@
                                @if (_esAdministrador)
                                {
                                    <div class="itm-tarjeta__admin">
                                        <a href="/admin/sesiones/@sesionId">Administrar sesión</a>
                                        <a href="/admin/eventos/@evento.Id/editar">Editar evento</a>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                    @if (visibles.Count > _limite)
                    {
                        <div class="itm-mas">
                            <button type="button" class="btn btn-itm-secundario" @onclick="MostrarMas">Mostrar más actividades (@(visibles.Count - _limite) restantes)</button>
                        </div>
                    }
                }
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<EventoResumenDto>>? _estado;
    private readonly HashSet<Guid> _sesionesVentanaCerrada = new();
    // Estado de las reservas activas del propio usuario por sesión (0 = Confirmada, 1 = En lista de espera). Solo presentación.
    private Dictionary<Guid, int> _misReservas = new();
    private Guid? _sesionEnProcesoId;
    private DateTime? _diaSeleccionado;
    private bool _esAdministrador;
    private const int TamanoPagina = 12;
    private int _limite = TamanoPagina;

    private void SeleccionarDia(DateTime? dia)
    {
        _diaSeleccionado = dia;
        _limite = TamanoPagina;
    }

    private void MostrarMas() => _limite += TamanoPagina;

    private static List<(EventoResumenDto Evento, SesionResumenDto Sesion)> ObtenerSesiones(IReadOnlyList<EventoResumenDto> eventos) =>
        eventos.SelectMany(e => (e.Sesiones ?? new()).Where(s => s.FechaHoraInicio.HasValue).Select(s => (Evento: e, Sesion: s)))
               .OrderBy(x => x.Sesion.FechaHoraInicio).ToList();

    // Solo presentación: ancho de la barra según lo que informa el backend (no se reimplementa ninguna regla de cupo)
    private static int PorcentajeOcupado(SesionResumenDto s) =>
        s.CupoMaximo is > 0 ? Math.Clamp((int)Math.Round((s.CuposOcupados ?? 0) * 100.0 / s.CupoMaximo.Value), 0, 100) : 0;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion != null)
        {
            var estado = await EstadoAutenticacion;
            _esAdministrador = estado.User.IsInRole("Administrador");
        }

        await CargarEventos();
    }

    private async Task CargarEventos()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<EventoResumenDto>>.Cargando();
        _estado = await EventosService.ObtenerEventosDisponiblesAsync();

        // Marca en cada tarjeta lo que ya reservé (RF-020); si falla, la lista de actividades sigue funcionando
        var mias = await ReservasService.ObtenerMisReservasAsync();
        if (mias.EsExito && mias.Valor != null)
        {
            _misReservas = mias.Valor
                .Where(r => r.SesionEventoId.HasValue && r.Estado is 0 or 1 && r.SesionCancelada != true)
                .GroupBy(r => r.SesionEventoId!.Value)
                .ToDictionary(g => g.Key, g => g.First().Estado ?? 0);
        }
    }

    // Cuándo: fecha y horario en America/Bogotá (la conversión solo se hace aquí, IZonaHorariaService)
    private string CuandoTexto(SesionResumenDto sesion)
    {
        if (!sesion.FechaHoraInicio.HasValue) return string.Empty;
        var inicio = ZonaHoraria.AHoraLocal(sesion.FechaHoraInicio.Value).DateTime;
        var texto = $"{PresentacionFechas.FechaCorta(inicio)}, {PresentacionFechas.HoraCompleta(inicio)}";
        if (sesion.FechaHoraFin.HasValue)
            texto += $" – {PresentacionFechas.HoraCompleta(ZonaHoraria.AHoraLocal(sesion.FechaHoraFin.Value).DateTime)}";
        return texto;
    }

    private async Task RealizarReserva(Guid sesionId, string actividad, string cuando)
    {
        if (sesionId == Guid.Empty) return;

        _sesionEnProcesoId = sesionId;

        var resultado = await ReservasService.ReservarAsync(sesionId);
        _sesionEnProcesoId = null;

        var datos = new List<DatoAviso> { new("Actividad", actividad), new("Cuándo", cuando) };

        if (resultado.EsExito && resultado.Valor != null)
        {
            // Estado: 0 = Confirmada, 1 = EnListaEspera
            if (resultado.Valor.Estado == 1)
            {
                // RF-003: Cupo agotado, ubicado en lista de espera (sin posición ni nivel: RN-020)
                Avisos.Espera("Quedaste en lista de espera", "Esta actividad no tiene cupo libre por ahora.", datos);
            }
            else
            {
                // RF-002: Reserva confirmada
                Avisos.Exito("¡Reserva confirmada!", "Puedes consultarla en Mis reservas.", "Ver mis reservas", "/reservas", datos);
            }

            // Refrescar listado para actualizar cupos
            await CargarEventos();
        }
        else
        {
            if (resultado.CodigoError == "VentanaNoAbierta")
            {
                _sesionesVentanaCerrada.Add(sesionId);
                Avisos.Error("No se pudo reservar", "Reservas aún no disponibles para esta sesión.", datos);
            }
            else
            {
                Avisos.Error("No se pudo reservar", resultado.MensajeError ?? "No fue posible procesar la reserva.", datos);
            }
        }
    }
}
