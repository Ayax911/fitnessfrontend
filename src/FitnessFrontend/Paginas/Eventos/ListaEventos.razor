@* RF-001: Listar eventos y actividades disponibles en el gimnasio *@
@* RF-002: Reservar cupo en una sesión *@
@* RF-003: Ubicación automática en lista de espera si el cupo está agotado *@
@page "/eventos"
@attribute [Authorize]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Eventos
@using FitnessFrontend.Servicios.Reservas
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IEventosClienteService EventosService
@inject IReservasClienteService ReservasService
@inject IZonaHorariaService ZonaHoraria

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Actividades</h1>
            <p>Elige un día y reserva tu cupo.</p>
        </div>
        <button class="btn btn-itm-secundario btn-sm" @onclick="CargarEventos" disabled="@(_estado?.EsCargando == true)">
            Actualizar
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensajeGlobal))
    {
        <div class="alert @(_mensajeEsExito ? "alert-success" : "alert-warning") alert-dismissible fade show mb-4" role="alert">
            @_mensajeGlobal
            <button type="button" class="btn-close" @onclick="() => _mensajeGlobal = null" aria-label="Cerrar"></button>
        </div>
    }

    <EstadoDeCarga Estado="@_estado" AlReintentar="CargarEventos" MensajeCargando="Cargando actividades disponibles...">
        <CargandoTemplate>
            @* Esqueleto: conserva la jerarquía (selector de día, hora, título, cupo, botón) mientras llegan los datos *@
            <div class="itm-chips" aria-hidden="true"><span class="itm-esq itm-esq--chip"></span><span class="itm-esq itm-esq--chip"></span><span class="itm-esq itm-esq--chip"></span></div>
            <EsqueletoTarjetas Cantidad="6" Mensaje="Cargando actividades disponibles..." />
        </CargandoTemplate>
        <ExitoTemplate Context="eventos">
            @{
                var sesiones = ObtenerSesiones(eventos);
                var dias = sesiones.Select(x => ZonaHoraria.AHoraLocal(x.Sesion.FechaHoraInicio!.Value).Date).Distinct().OrderBy(d => d).Take(7).ToList();
                var visibles = _diaSeleccionado == null ? sesiones : sesiones.Where(x => ZonaHoraria.AHoraLocal(x.Sesion.FechaHoraInicio!.Value).Date == _diaSeleccionado).ToList();
            }
            @if (eventos.Count == 0)
            {
                <div class="itm-vacio">
                    <h2>No hay actividades programadas</h2>
                    <p>En este momento no hay eventos disponibles para reserva. Por favor consulta más tarde.</p>
                </div>
            }
            else
            {
                @if (dias.Count > 1)
                {
                    <div class="itm-chips" role="group" aria-label="Día">
                        <button type="button" class="itm-chip" aria-pressed="@(_diaSeleccionado == null ? "true" : "false")" @onclick="() => _diaSeleccionado = null">Todos</button>
                        @foreach (var dia in dias)
                        {
                            var d = dia;
                            <button type="button" class="itm-chip" aria-pressed="@(_diaSeleccionado == d ? "true" : "false")" @onclick="() => _diaSeleccionado = d">@EtiquetaDia(d)</button>
                        }
                    </div>
                }

                @if (visibles.Count == 0)
                {
                    <div class="itm-vacio">
                        <h2>No hay sesiones programadas</h2>
                        <p>Este día no tiene sesiones activas. Elige otro día.</p>
                    </div>
                }
                else
                {
                    <div class="itm-rejilla">
                        @foreach (var item in visibles)
                        {
                            var evento = item.Evento;
                            var sesion = item.Sesion;
                            var sesionId = sesion.Id ?? Guid.Empty;
                            var estaBloqueadaPorVentana = _sesionesVentanaCerrada.Contains(sesionId);
                            var estaProcesandoEsta = _sesionEnProcesoId == sesionId;
                            var hayCupo = sesion.CuposDisponibles.HasValue && sesion.CuposDisponibles.Value > 0;

                            <article class="itm-tarjeta" @key="sesionId">
                                <div>
                                    <p class="itm-tarjeta__hora">
                                        @if (sesion.FechaHoraInicio.HasValue && sesion.FechaHoraFin.HasValue)
                                        {
                                            <span class="itm-nobr">@ZonaHoraria.FormatearHora(sesion.FechaHoraInicio.Value)</span> <span class="itm-nobr">– @ZonaHoraria.FormatearHora(sesion.FechaHoraFin.Value)</span>
                                        }
                                        else if (sesion.FechaHoraInicio.HasValue)
                                        {
                                            @ZonaHoraria.FormatearHora(sesion.FechaHoraInicio.Value)
                                        }
                                    </p>
                                    @if (sesion.FechaHoraInicio.HasValue)
                                    {
                                        <p class="itm-tarjeta__fecha">@ZonaHoraria.FormatearFecha(sesion.FechaHoraInicio.Value)@(evento.EsRecurrente == true ? " · Recurrente" : "")</p>
                                    }
                                </div>
                                <div>
                                    <h2 class="itm-tarjeta__titulo" title="@evento.Nombre">@evento.Nombre</h2>
                                    <p class="itm-meta">Entrenador: @(evento.EntrenadorNombre ?? "Por asignar")</p>
                                    @if (!string.IsNullOrWhiteSpace(evento.Descripcion))
                                    {
                                        <p class="itm-meta texto-extenso">@evento.Descripcion</p>
                                    }
                                    @* I-08 / RN-020 / AMB-014: No se muestra la fecha base de apertura de reservas públicamente
                                       para evitar que usuarios con ventana desplazada deduzcan su condición personal. *@
                                </div>

                                <div class="itm-tarjeta__pie">
                                    @* Cupo: el número va siempre en texto; la barra solo refuerza. Sin puntos por cupo (los eventos suelen superar 30 personas). *@
                                    @if (hayCupo)
                                    {
                                        <div class="itm-cupo">
                                            <span class="itm-cupo__texto">@sesion.CuposDisponibles cupos</span>
                                            @if (sesion.CupoMaximo is > 0)
                                            {
                                                <div class="itm-cupo__barra" aria-hidden="true"><span style="width: @PorcentajeOcupado(sesion)%"></span></div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div><InsigniaEstado Tipo="espera">Agotado (Espera)</InsigniaEstado></div>
                                    }

                                    @* PENDIENTE (AMB-014): mensaje genérico neutro mientras el stakeholder no defina
                                       si debe mostrarse un texto explicativo o simplemente ocultarse la acción.
                                       No añadir motivo, nivel ni fecha estimada — violaría RN-020. *@
                                    @if (estaBloqueadaPorVentana)
                                    {
                                        <p class="itm-nota" role="note">Reservas aún no disponibles para esta sesión</p>
                                    }

                                    <BotonAccion Tipo="button"
                                                 Clase="btn-itm-primario itm-btn-bloque"
                                                 Deshabilitado="@(estaBloqueadaPorVentana || _sesionEnProcesoId.HasValue)"
                                                 EstaProcesando="@estaProcesandoEsta"
                                                 TextoProcesando="Reservando..."
                                                 OnClick="@(() => RealizarReserva(sesionId))">
                                        Reservar cupo
                                    </BotonAccion>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </ExitoTemplate>
    </EstadoDeCarga>
</div>

@code {
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<EventoResumenDto>>? _estado;
    private readonly HashSet<Guid> _sesionesVentanaCerrada = new();
    private Guid? _sesionEnProcesoId;
    private DateTime? _diaSeleccionado;
    private string? _mensajeGlobal;
    private bool _mensajeEsExito;

    private static List<(EventoResumenDto Evento, SesionResumenDto Sesion)> ObtenerSesiones(IReadOnlyList<EventoResumenDto> eventos) =>
        eventos.SelectMany(e => (e.Sesiones ?? new()).Where(s => s.FechaHoraInicio.HasValue).Select(s => (Evento: e, Sesion: s)))
               .OrderBy(x => x.Sesion.FechaHoraInicio).ToList();

    private string EtiquetaDia(DateTime dia)
    {
        var hoy = ZonaHoraria.ObtenerFechaHoyLocal().Date;
        if (dia == hoy) return "Hoy";
        if (dia == hoy.AddDays(1)) return "Mañana";
        return dia.ToString("dd/MM/yyyy"); // ya es fecha local (AHoraLocal); no se vuelve a convertir
    }

    // Solo presentación: ancho de la barra según lo que informa el backend (no se reimplementa ninguna regla de cupo)
    private static int PorcentajeOcupado(SesionResumenDto s) =>
        s.CupoMaximo is > 0 ? Math.Clamp((int)Math.Round((s.CuposOcupados ?? 0) * 100.0 / s.CupoMaximo.Value), 0, 100) : 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarEventos();
    }

    private async Task CargarEventos()
    {
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IReadOnlyList<EventoResumenDto>>.Cargando();
        _estado = await EventosService.ObtenerEventosDisponiblesAsync();
    }

    private async Task RealizarReserva(Guid sesionId)
    {
        if (sesionId == Guid.Empty) return;

        _sesionEnProcesoId = sesionId;
        _mensajeGlobal = null;

        var resultado = await ReservasService.ReservarAsync(sesionId);
        _sesionEnProcesoId = null;

        if (resultado.EsExito && resultado.Valor != null)
        {
            _mensajeEsExito = true;
            // Estado: 0 = Confirmada, 1 = EnListaEspera
            if (resultado.Valor.Estado == 1)
            {
                // RF-003: Cupo agotado, ubicado en lista de espera
                _mensajeGlobal = "Cupo agotado. Has sido ubicado en la lista de espera para esta sesión.";
            }
            else
            {
                // RF-002: Reserva confirmada
                _mensajeGlobal = "¡Reserva confirmada exitosamente! Puedes consultarla en Mis Reservas.";
            }

            // Refrescar listado para actualizar cupos
            await CargarEventos();
        }
        else
        {
            _mensajeEsExito = false;

            @* PENDIENTE (AMB-014): mensaje genérico neutro mientras el stakeholder no defina
               si debe mostrarse un texto explicativo o simplemente ocultarse la acción.
               No añadir motivo, nivel ni fecha estimada — violaría RN-020. *@
            if (resultado.CodigoError == "VentanaNoAbierta")
            {
                _sesionesVentanaCerrada.Add(sesionId);
                _mensajeGlobal = "Reservas aún no disponibles para esta sesión.";
            }
            else
            {
                _mensajeGlobal = resultado.MensajeError ?? "No fue posible procesar la reserva.";
            }
        }
    }
}
