@* RF-016: Consultar indicador y trazabilidad de priorización de un usuario (Administrador) *@
@page "/admin/priorizacion/usuarios"
@page "/admin/priorizacion/usuarios/{IdUsuario:guid}"
@attribute [Authorize(Roles = "Administrador")]
@using FitnessFrontend.ApiCliente.Models
@using FitnessFrontend.Servicios.Priorizacion
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IPriorizacionClienteService PriorizacionService
@inject FitnessFrontend.Servicios.Usuarios.IUsuariosClienteService UsuariosService
@inject IZonaHorariaService ZonaHoraria

<div class="container py-4">
    <div class="mb-4 pb-2 border-bottom">
        <span class="badge badge-itm-priorizacion mb-2">Módulo Restringido — Administrador</span>
        <h1 class="h2 fw-bold text-itm-priorizacion mb-1">
            <span class="bi bi-shield-lock me-2"></span>Indicador de Priorización
        </h1>
        <p class="text-muted mb-0">Auditoría del nivel de prioridad y métricas de confiabilidad de un usuario (RN-020).</p>
    </div>

    @* RF-016 + RF-023: se busca a la persona por nombre o correo; ya no se escribe un GUID *@
    <div class="card card-itm card-itm-priorizacion shadow-sm mb-4">
        <div class="card-body p-4">
            <label for="inputBusquedaUsuario" class="form-label fw-bold small text-uppercase text-muted">
                Buscar usuario por nombre o correo
            </label>
            <form @onsubmit="BuscarCoincidencias" @onsubmit:preventDefault class="input-group">
                <input id="inputBusquedaUsuario" type="search" class="form-control" placeholder="Ej. maria o maria@itm.edu.co"
                       @bind="_busqueda" @bind:event="oninput" />
                <button class="btn btn-itm-priorizacion" type="submit" disabled="@_buscando">
                    @if (_buscando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Buscando...</span>
                    }
                    else
                    {
                        <span class="bi bi-search me-1"></span>
                        <span>Buscar</span>
                    }
                </button>
            </form>
            <div class="form-text small">
                Elija a la persona para consultar el nivel asignado automáticamente por el motor de priorización.
            </div>

            @if (_coincidencias != null)
            {
                @if (_coincidencias.EsError)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@_coincidencias.MensajeError</div>
                }
                else if (_coincidencias.Valor?.Items == null || _coincidencias.Valor.Items.Count == 0)
                {
                    <div class="text-muted mt-3">No se encontraron usuarios con esos criterios.</div>
                }
                else
                {
                    <ul class="list-group mt-3" aria-label="Coincidencias">
                        @foreach (var u in _coincidencias.Valor.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <span class="fw-semibold">@u.NombreCompleto</span>
                                    <span class="text-muted small ms-2">@u.Email</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-itm-priorizacion" @onclick="() => Consultar(u.Id!.Value)" disabled="@_buscando">Consultar</button>
                            </li>
                        }
                    </ul>
                    @if ((_coincidencias.Valor.Total ?? 0) > _coincidencias.Valor.Items.Count)
                    {
                        <div class="form-text small mt-2">Se muestran los primeros @_coincidencias.Valor.Items.Count de @_coincidencias.Valor.Total. Refine la búsqueda.</div>
                    }
                }
            }
        </div>
    </div>

    @if (_estado != null)
    {
        <EstadoDeCarga Estado="@_estado" AlReintentar="ReintentarConsulta" MensajeCargando="Consultando métricas del usuario...">
            <ExitoTemplate Context="indicador">
                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card card-itm h-100 shadow-sm border-start border-4 border-primary">
                            <div class="card-body p-4">
                                <h6 class="text-muted small text-uppercase fw-bold mb-2">Nivel de Priorización Actual</h6>
                                <div class="d-flex align-items-center mb-3">
                                    @switch (indicador.Nivel)
                                    {
                                        case 0:
                                            <span class="badge bg-info text-dark fs-5 p-2 me-2">
                                                <span class="bi bi-sparkles me-1"></span> Nuevo
                                            </span>
                                            break;
                                        case 1:
                                            <span class="badge bg-success fs-5 p-2 me-2">
                                                <span class="bi bi-star-fill me-1"></span> Prioritario
                                            </span>
                                            break;
                                        case 2:
                                            <span class="badge bg-primary fs-5 p-2 me-2">
                                                <span class="bi bi-person-check-fill me-1"></span> Normal
                                            </span>
                                            break;
                                        case 3:
                                            <span class="badge bg-danger fs-5 p-2 me-2">
                                                <span class="bi bi-exclamation-octagon-fill me-1"></span> Penalizado
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary fs-5 p-2 me-2">
                                                Nivel @(indicador.Nivel)
                                            </span>
                                            break;
                                    }
                                </div>
                                <p class="small text-secondary mb-0">
                                    Nivel confidencial no visible para Usuario ni Entrenador (RN-020).
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card card-itm h-100 shadow-sm border-start border-4 border-info">
                            <div class="card-body p-4">
                                <h6 class="text-muted small text-uppercase fw-bold mb-2">Racha de Asistencia</h6>
                                <h3 class="display-6 fw-bold text-primary mb-1">
                                    @(indicador.RachaAsistenciasActual ?? 0)
                                </h3>
                                <p class="small text-secondary mb-0">Asistencias consecutivas registradas sin faltas.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card card-itm h-100 shadow-sm border-start border-4 border-warning">
                            <div class="card-body p-4">
                                <h6 class="text-muted small text-uppercase fw-bold mb-2">Total Inasistencias</h6>
                                <h3 class="display-6 fw-bold text-danger mb-1">
                                    @(indicador.TotalInasistencias ?? 0)
                                </h3>
                                <p class="small text-secondary mb-0">Faltas acumuladas en sesiones confirmadas.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card card-itm shadow-sm">
                            <div class="card-header card-itm-header">
                                <h5 class="card-title mb-0 fw-bold">Información de Auditoría</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="small text-muted">ID de Usuario:</div>
                                        <div class="fw-semibold text-break">@indicador.UsuarioId</div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="small text-muted">Correo Electrónico:</div>
                                        <div class="fw-semibold">@(indicador.Email ?? "—")</div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="small text-muted">Nombre Registrado:</div>
                                        <div class="fw-semibold">@(indicador.NombreUsuario ?? "—")</div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="small text-muted">Total Sesiones Asistidas:</div>
                                        <div class="fw-semibold">@(indicador.TotalAsistidas ?? 0)</div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="small text-muted">Último Recálculo de Nivel:</div>
                                        <div class="fw-semibold">
                                            @(indicador.UltimoRecalculo.HasValue ? ZonaHoraria.FormatearFechaHora(indicador.UltimoRecalculo.Value) : "No registrado")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ExitoTemplate>
        </EstadoDeCarga>
    }
</div>

@code {
    [Parameter]
    public Guid? IdUsuario { get; set; }

    private string? _busqueda;
    private bool _buscando;
    private Guid? _ultimoUsuarioId;
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<PaginaUsuariosDto>? _coincidencias;
    private FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IndicadorAdministradorDto>? _estado;

    protected override async Task OnParametersSetAsync()
    {
        // Enlace directo desde Usuarios y roles: /admin/priorizacion/usuarios/{id}
        if (IdUsuario.HasValue && IdUsuario != Guid.Empty)
        {
            await Consultar(IdUsuario.Value);
        }
    }

    private async Task BuscarCoincidencias()
    {
        if (string.IsNullOrWhiteSpace(_busqueda))
        {
            _coincidencias = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<PaginaUsuariosDto>.Fallo(
                "Escriba el nombre o el correo de la persona.");
            return;
        }

        _buscando = true;
        _coincidencias = await UsuariosService.BuscarAsync(_busqueda, null, 1, 10);
        _buscando = false;
    }

    private Task ReintentarConsulta() =>
        _ultimoUsuarioId.HasValue ? Consultar(_ultimoUsuarioId.Value) : Task.CompletedTask;

    private async Task Consultar(Guid usuarioId)
    {
        _ultimoUsuarioId = usuarioId;
        _buscando = true;
        _estado = FitnessFrontend.Servicios.Infraestructura.EstadoDeCarga<IndicadorAdministradorDto>.Cargando();
        _estado = await PriorizacionService.ConsultarIndicadorUsuarioAsync(usuarioId);
        _buscando = false;
    }
}
