@* RF-032: Registro de auditoría de solo anexar para acciones administrativas *@
@page "/admin/auditoria"
@attribute [Authorize(Roles = "Administrador")]
@using FitnessFrontend.Servicios.Auditoria
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IAuditoriaClienteService AuditoriaService
@inject IZonaHorariaService ZonaHoraria

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Registro de auditoría</h1>
            <p>Historial que no se puede modificar de las acciones administrativas y operativas del sistema.</p>
        </div>
        <button class="btn btn-itm-secundario btn-sm" @onclick="() => CargarPagina(1)">Actualizar</button>
    </div>

    @* Barra de filtros *@
    <div class="card-itm p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="filtroAccion" class="form-label small fw-bold">Tipo de acción:</label>
                <select id="filtroAccion" class="form-select form-select-sm" @bind="_filtroAccion">
                    <option value="">Todas las acciones</option>
                    <option value="CancelarSesion">Cancelar sesión</option>
                    <option value="ReprogramarSesion">Reprogramar sesión</option>
                    <option value="CrearBloqueo">Crear bloqueo</option>
                    <option value="EliminarBloqueo">Eliminar bloqueo</option>
                    <option value="InscribirTercero">Inscribir tercero</option>
                    <option value="RetirarTercero">Retirar tercero</option>
                    <option value="AsistenciaManual">Asistencia manual</option>
                    <option value="AsignarRol">Asignar rol</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label for="filtroActor" class="form-label small fw-bold">Actor / Usuario:</label>
                <input id="filtroActor" type="text" class="form-control form-control-sm" placeholder="Buscar por nombre o rol" @bind="_filtroActor" />
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-itm-primario btn-sm me-2" style="min-height: 38px;" @onclick="() => CargarPagina(1)">
                    Aplicar filtros
                </button>
                <button type="button" class="btn btn-itm-secundario btn-sm" style="min-height: 38px;" @onclick="LimpiarFiltros">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    @if (_cargando)
    {
        <div role="status" aria-busy="true">
            <span class="itm-solo-lectores">Cargando registros de auditoría...</span>
            <EsqueletoLista Cantidad="6" Mensaje="Cargando auditoría..." />
        </div>
    }
    else if (_errorCarga != null)
    {
        <div class="alert alert-danger" role="alert">
            @_errorCarga
            <button class="btn btn-itm-primario btn-sm ms-3" @onclick="() => CargarPagina(1)">Reintentar</button>
        </div>
    }
    else if (_elementos.Count == 0)
    {
        <div class="card-itm p-5 text-center">
            <h2 class="h5 fw-bold text-muted mb-2">No se encontraron eventos de auditoría</h2>
            <p class="text-secondary mb-0">No hay registros que coincidan con los criterios de búsqueda seleccionados.</p>
        </div>
    }
    else
    {
        @* Vista responsive: en celular tarjetas; en desktop tabla *@
        <div class="card-itm p-0 overflow-hidden mb-4">
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 ps-3">Fecha y Hora (Bogotá)</th>
                            <th scope="col" class="py-3">Actor</th>
                            <th scope="col" class="py-3">Acción</th>
                            <th scope="col" class="py-3">Entidad</th>
                            <th scope="col" class="py-3 pe-3">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _elementos)
                        {
                            <tr @key="log.Id">
                                <td class="ps-3 text-nowrap fw-semibold" style="font-size: 13px;">
                                    @ZonaHoraria.FormatearFechaHora(log.FechaHoraUtc)
                                </td>
                                <td>
                                    <div class="fw-bold">@log.ActorNombre</div>
                                    <span class="badge bg-secondary" style="font-size: 10px;">@log.ActorRol</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @log.Accion
                                    </span>
                                </td>
                                <td class="text-muted small">@log.Entidad</td>
                                <td class="pe-3 small text-dark" style="max-width: 380px; word-break: break-word;">
                                    @log.Detalle
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Vista móvil (tarjetas) *@
            <div class="d-md-none p-3">
                @foreach (var log in _elementos)
                {
                    <div class="card p-3 mb-3 border shadow-sm" @key="log.Id">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary">@log.Accion</span>
                            <span class="text-muted small">@ZonaHoraria.FormatearFechaHora(log.FechaHoraUtc)</span>
                        </div>
                        <div class="fw-bold">@log.ActorNombre <span class="badge bg-secondary ms-1">@log.ActorRol</span></div>
                        <div class="text-muted small mb-2">Entidad: @log.Entidad</div>
                        <p class="mb-0 small text-dark">@log.Detalle</p>
                    </div>
                }
            </div>
        </div>

        @* Paginación accesible con botones de 48px *@
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted small">
                Página @_paginaActual de @_totalPaginas (Total: @_totalRegistros registros)
            </span>
            <div class="btn-group" role="group" aria-label="Paginación de auditoría">
                <button type="button"
                        class="btn btn-itm-secundario d-inline-flex align-items-center gap-1"
                        style="min-height: 48px; min-width: 48px;"
                        disabled="@(_paginaActual <= 1)"
                        @onclick="() => CargarPagina(_paginaActual - 1)"
                        aria-label="Página anterior">
                    <svg class="itm-icono" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Anterior</span>
                </button>
                <button type="button"
                        class="btn btn-itm-secundario d-inline-flex align-items-center gap-1"
                        style="min-height: 48px; min-width: 48px;"
                        disabled="@(_paginaActual >= _totalPaginas)"
                        @onclick="() => CargarPagina(_paginaActual + 1)"
                        aria-label="Página siguiente">
                    <span>Siguiente</span>
                    <svg class="itm-icono" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _cargando = true;
    private string? _errorCarga;

    private List<RegistroAuditoriaDto> _elementos = new();
    private int _totalRegistros;
    private int _paginaActual = 1;
    private int _totalPaginas = 1;

    private string _filtroAccion = string.Empty;
    private string _filtroActor = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarPagina(1);
    }

    private async Task CargarPagina(int pagina)
    {
        _cargando = true;
        _errorCarga = null;

        try
        {
            var tipo = string.IsNullOrWhiteSpace(_filtroAccion) ? null : _filtroAccion;
            var actor = string.IsNullOrWhiteSpace(_filtroActor) ? null : _filtroActor;

            var res = await AuditoriaService.ConsultarAuditoriaAsync(
                tipoAccion: tipo,
                actor: actor,
                pagina: pagina,
                tamano: 25);

            if (res.EsExito && res.Valor != null)
            {
                _elementos = res.Valor.Elementos.ToList();
                _totalRegistros = res.Valor.TotalRegistros;
                _paginaActual = res.Valor.PaginaActual;
                _totalPaginas = res.Valor.TotalPaginas;
            }
            else
            {
                _errorCarga = res.MensajeError ?? "No fue posible cargar el registro de auditoría.";
            }
        }
        catch (Exception ex)
        {
            _errorCarga = $"Error al consultar auditoría: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task LimpiarFiltros()
    {
        _filtroAccion = string.Empty;
        _filtroActor = string.Empty;
        await CargarPagina(1);
    }
}
