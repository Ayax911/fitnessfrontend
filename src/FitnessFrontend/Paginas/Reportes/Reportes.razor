@* RF-033: Reportes operativos y exportación CSV (Administrador) *@
@page "/admin/reportes"
@attribute [Authorize(Roles = "Administrador")]
@using FitnessFrontend.Servicios.Reportes
@using FitnessFrontend.Servicios.Infraestructura
@using FitnessFrontend.Componentes.Compartidos
@inject IReportesClienteService ReportesService
@inject IZonaHorariaService ZonaHoraria
@inject IJSRuntime JS

<div class="itm-contenedor itm-pagina">
    <div class="itm-pagina__cabecera">
        <div>
            <h1>Reportes y métricas operativas</h1>
            <p>Monitoreo de asistencia, ocupación de cupos, inasistencias y horas de mayor afluencia.</p>
        </div>
        <button class="btn btn-itm-secundario btn-sm" @onclick="CargarReporteActual">Actualizar datos</button>
    </div>

    @* Selector de rango de fechas con atajos *@
    <div class="card-itm p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="fechaDesde" class="form-label small fw-bold">Fecha inicial:</label>
                <input id="fechaDesde" type="date" class="form-control form-control-sm" @bind="_fechaDesdeLocal" />
            </div>
            <div class="col-12 col-md-3">
                <label for="fechaHasta" class="form-label small fw-bold">Fecha final:</label>
                <input id="fechaHasta" type="date" class="form-control form-control-sm" @bind="_fechaHastaLocal" />
            </div>
            <div class="col-12 col-md-6 d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-itm-primario btn-sm" style="min-height: 38px;" @onclick="CargarReporteActual">
                    Consultar
                </button>
                <div class="btn-group" role="group" aria-label="Atajos de fecha">
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="min-height: 38px;" @onclick="AtajoUltimos7Dias">Últimos 7 días</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="min-height: 38px;" @onclick="AtajoEsteMes">Este mes</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" style="min-height: 38px;" @onclick="AtajoMesAnterior">Mes anterior</button>
                    @if (_pestañaActiva == "Mensual")
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" style="min-height: 38px;" @onclick="AtajoUltimos12Meses">Últimos 12 meses</button>
                    }
                </div>
            </div>
        </div>

        @if (_errorRangoFechas != null)
        {
            <div class="alert alert-warning py-2 mt-2 mb-0 small" role="alert">
                @_errorRangoFechas
            </div>
        }
    </div>

    @* Navegación por pestañas de reportes *@
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Asistencia" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Asistencia"))">
                Asistencia por sesión
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Ocupacion" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Ocupacion"))">
                Ocupación
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Inasistencias" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Inasistencias"))">
                Inasistencias
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "HorasPico" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("HorasPico"))">
                Horas pico
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Uso" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Uso"))">
                Uso de plataforma
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Mensual" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Mensual"))">
                Resumen mensual
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_pestañaActiva == "Pantallas" ? "active fw-bold" : "")"
                    style="min-height: 48px;"
                    role="tab"
                    @onclick="@(() => CambiarPestana("Pantallas"))">
                Uso de pantallas
            </button>
        </li>
    </ul>

    @* La región cambia de contenido al cargar, pero conserva su altura (.itm-area-estable): la pantalla no salta *@
    <div class="itm-area-estable">
    @if (_cargando)
    {
        <EsqueletoReporte Filas="8" />
    }
    else
    {
        @* Pestaña 1: Asistencia por sesión *@
        @if (_pestañaActiva == "Asistencia")
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Asistencia por Sesión</h2>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvAsistencia">
                        Descargar CSV
                    </button>
                </div>

                @if (_reporteAsistencia.Count == 0)
                {
                    <p class="text-muted small">No hay sesiones registradas en el rango de fechas seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Actividad</th>
                                    <th>Fecha y Hora (Bogotá)</th>
                                    <th>Capacidad</th>
                                    <th>Inscritos</th>
                                    <th>Asistentes</th>
                                    <th>No Asistieron</th>
                                    <th>% Asistencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _reporteAsistencia)
                                {
                                    <tr @key="r.SesionId">
                                        <td class="fw-semibold">@r.EventoNombre</td>
                                        <td class="small">@ZonaHoraria.FormatearFechaHora(r.FechaHora)</td>
                                        <td>@r.CupoMaximo</td>
                                        <td>@r.Inscritos</td>
                                        <td class="text-success fw-bold">@r.Asistentes</td>
                                        <td class="text-danger">@r.NoAsistentes</td>
                                        <td>
                                            <span class="badge @(r.PorcentajeAsistencia >= 85 ? "bg-success" : "bg-warning text-dark")">
                                                @r.PorcentajeAsistencia.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 2: Ocupación *@
        @if (_pestañaActiva == "Ocupacion")
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Ocupación de Cupos</h2>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvOcupacion">
                        Descargar CSV
                    </button>
                </div>

                @if (_reporteOcupacion.Count == 0)
                {
                    <p class="text-muted small">Sin datos de ocupación para el rango seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Actividad</th>
                                    <th>Fecha</th>
                                    <th>Cupo Ofrecido</th>
                                    <th>Cupo Ocupado</th>
                                    <th>% Ocupación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in _reporteOcupacion)
                                {
                                    <tr @key="o.EventoNombre + o.Fecha.ToString()">
                                        <td class="fw-semibold">@o.EventoNombre</td>
                                        <td>@o.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@o.CupoTotal</td>
                                        <td>@o.CupoOcupado</td>
                                        <td>
                                            <span class="badge @(o.PorcentajeOcupacion >= 90 ? "bg-success" : "bg-primary")">
                                                @o.PorcentajeOcupacion.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 3: Inasistencias (agregado, sin datos personales RN-020) *@
        @if (_pestañaActiva == "Inasistencias")
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Inasistencias por Actividad</h2>
                        <p class="text-muted small mb-0">Datos consolidados por evento.</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvInasistencias">
                        Descargar CSV
                    </button>
                </div>

                @if (_reporteInasistencias.Count == 0)
                {
                    <p class="text-muted small">No hay inasistencias registradas en este periodo.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Actividad</th>
                                    <th>Total Reservas</th>
                                    <th>Inasistencias</th>
                                    <th>Tasa de Inasistencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ina in _reporteInasistencias)
                                {
                                    <tr @key="ina.EventoNombre">
                                        <td class="fw-semibold">@ina.EventoNombre</td>
                                        <td>@ina.TotalReservas</td>
                                        <td class="text-danger fw-bold">@ina.Inasistencias</td>
                                        <td>
                                            <span class="badge @(ina.TasaInasistencia > 15 ? "bg-danger" : "bg-secondary")">
                                                @ina.TasaInasistencia.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 4: Horas pico *@
        @if (_pestañaActiva == "HorasPico")
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Horas Pico y Afluencia</h2>
                        <p class="text-muted small mb-0">Franjas de mayor concurrencia en hora local (America/Bogota).</p>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvHorasPico">
                        Descargar CSV
                    </button>
                </div>

                @if (_reporteHorasPico.Count == 0)
                {
                    <p class="text-muted small">Sin datos de horas pico en el rango seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Día</th>
                                    <th>Franja Horaria</th>
                                    <th>Ingresos y Asistencias</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _reporteHorasPico)
                                {
                                    var horaLocal = new DateTime(2026, 1, 1, h.FranjaHora, 0, 0);
                                    var textoFranja = horaLocal.ToString("hh:00 tt", new System.Globalization.CultureInfo("es-CO"));

                                    <tr @key="h.DiaSemana + h.FranjaHora">
                                        <td class="fw-semibold">@h.DiaSemana</td>
                                        <td>@textoFranja – @horaLocal.AddHours(1).ToString("hh:00 tt", new System.Globalization.CultureInfo("es-CO"))</td>
                                        <td>
                                            <span class="badge bg-primary">@h.TotalIngresosYCheckins personas</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 5: Uso de la plataforma *@
        @if (_pestañaActiva == "Uso" && _reporteUso != null)
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Uso General de la Plataforma</h2>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvUso">
                        Descargar CSV
                    </button>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 border rounded text-center bg-light">
                            <div class="text-muted small">Registros nuevos</div>
                            <div class="h3 fw-bold text-primary mb-0 mt-1">@_reporteUso.RegistrosNuevos</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 border rounded text-center bg-light">
                            <div class="text-muted small">Usuarios activos (máximo en un día)</div>
                            <div class="h3 fw-bold text-success mb-0 mt-1">@_reporteUso.UsuariosActivos</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 border rounded text-center bg-light">
                            <div class="text-muted small">Reservas creadas</div>
                            <div class="h3 fw-bold text-dark mb-0 mt-1">@_reporteUso.ReservasCreadas</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="p-3 border rounded text-center bg-light">
                            <div class="text-muted small">Cancelaciones</div>
                            <div class="h3 fw-bold text-danger mb-0 mt-1">@_reporteUso.Cancelaciones</div>
                        </div>
                    </div>
                </div>

                @if (_reporteUso.Diario is { Count: > 0 })
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-sm align-middle mb-0">
                            <caption class="visually-hidden">Uso de la plataforma por día</caption>
                            <thead>
                                <tr><th scope="col">Día</th><th scope="col" class="text-end">Registros nuevos</th><th scope="col" class="text-end">Usuarios activos</th><th scope="col" class="text-end">Reservas creadas</th><th scope="col" class="text-end">Cancelaciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var dia in _reporteUso.Diario)
                                {
                                    <tr><td>@dia.Fecha.ToString("dd/MM/yyyy")</td><td class="text-end">@dia.RegistrosNuevos</td><td class="text-end">@dia.UsuariosActivos</td><td class="text-end">@dia.ReservasCreadas</td><td class="text-end">@dia.Cancelaciones</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 6: Resumen mensual (informes semestrales y anuales; hasta 24 meses) *@
        @if (_pestañaActiva == "Mensual")
        {
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Resumen mensual</h2>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvMensual">
                        Descargar CSV
                    </button>
                </div>
                <p class="text-muted small">Una fila por mes calendario (el backend cuenta los meses en UTC). Admite hasta 24 meses; los demás reportes, 90 días. «Usuarios activos» son personas distintas en el mes, por eso no se suman entre meses.</p>

                @if (_reporteMensual.Count == 0)
                {
                    <p class="text-muted small">No hay datos en el rango seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <caption class="visually-hidden">Resumen mensual de actividad</caption>
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Mes</th>
                                    <th scope="col" class="text-end">Sesiones</th>
                                    <th scope="col" class="text-end">Sesiones canceladas</th>
                                    <th scope="col" class="text-end">Reservas</th>
                                    <th scope="col" class="text-end">Cancelaciones</th>
                                    <th scope="col" class="text-end">Asistencias</th>
                                    <th scope="col" class="text-end">Ingresos generales</th>
                                    <th scope="col" class="text-end">Usuarios activos</th>
                                    <th scope="col" class="text-end">Registros nuevos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in _reporteMensual)
                                {
                                    <tr @key="m.Mes">
                                        <td class="fw-semibold">@m.Mes.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-CO"))</td>
                                        <td class="text-end">@m.SesionesProgramadas</td>
                                        <td class="text-end">@m.SesionesCanceladas</td>
                                        <td class="text-end">@m.ReservasCreadas</td>
                                        <td class="text-end">@m.Cancelaciones</td>
                                        <td class="text-end">@m.AsistenciasSesion</td>
                                        <td class="text-end">@m.IngresosGenerales</td>
                                        <td class="text-end">@m.UsuariosActivos</td>
                                        <td class="text-end">@m.RegistrosNuevos</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Pestaña 7: Uso de pantallas (telemetría anónima del cliente) *@
        @if (_pestañaActiva == "Pantallas")
        {
            var totalVistas = _reportePantallas.Sum(p => p.Vistas);
            var vistasMovil = _reportePantallas.Where(p => p.Dispositivo == "movil").Sum(p => p.Vistas);
            <div class="card-itm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">Uso de pantallas</h2>
                    <button type="button" class="btn btn-outline-success btn-sm" style="min-height: 40px;" @onclick="ExportarCsvPantallas">
                        Descargar CSV
                    </button>
                </div>
                <p class="text-muted small">Datos anónimos: cuentan visitas por pantalla, dispositivo y rol; no identifican personas. Las rutas con identificadores se agrupan como «{id}».</p>

                @if (_reportePantallas.Count == 0)
                {
                    <p class="text-muted small">Aún no hay visitas registradas en el rango seleccionado.</p>
                }
                else
                {
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded text-center bg-light">
                                <div class="text-muted small">Visitas a pantallas</div>
                                <div class="h3 fw-bold text-primary mb-0 mt-1">@totalVistas</div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded text-center bg-light">
                                <div class="text-muted small">Desde el celular</div>
                                <div class="h3 fw-bold text-success mb-0 mt-1">@(totalVistas == 0 ? 0 : (int)Math.Round(100.0 * vistasMovil / totalVistas)) %</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <caption class="visually-hidden">Visitas por pantalla, dispositivo y rol</caption>
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Pantalla</th>
                                    <th scope="col">Dispositivo</th>
                                    <th scope="col">Rol</th>
                                    <th scope="col" class="text-end">Visitas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _reportePantallas)
                                {
                                    <tr @key="@($"{p.Pantalla}|{p.Dispositivo}|{p.Rol}")">
                                        <td><code>@p.Pantalla</code></td>
                                        <td>@p.Dispositivo</td>
                                        <td>@(p.Rol == "anonimo" ? "Sin sesión" : p.Rol)</td>
                                        <td class="text-end">@p.Vistas</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
    </div>
</div>

@code {
    private string _pestañaActiva = "Asistencia";
    private bool _cargando;
    private string? _errorRangoFechas;

    private DateTime _fechaDesdeLocal = DateTime.Today.AddDays(-14);
    private DateTime _fechaHastaLocal = DateTime.Today;

    private List<ReporteAsistenciaSesionDto> _reporteAsistencia = new();
    private List<ReporteOcupacionDto> _reporteOcupacion = new();
    private List<ReporteInasistenciasEventoDto> _reporteInasistencias = new();
    private List<ReporteHorasPicoDto> _reporteHorasPico = new();
    private ReporteUsoPlataformaDto? _reporteUso;
    private List<ReporteResumenMensualDto> _reporteMensual = new();
    private List<ReporteUsoPantallasDto> _reportePantallas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarReporteActual();
    }

    // Se espera la carga (async Task): con "fire and forget" Blazor no volvía a pintar al terminar y la pestaña se quedaba cargando
    private async Task CambiarPestana(string pestana)
    {
        _pestañaActiva = pestana;

        // El resumen mensual admite hasta 24 meses; los demás reportes, 90 días. Se ajusta el rango para no mostrar un error inmediato.
        var dias = (_fechaHastaLocal - _fechaDesdeLocal).TotalDays;
        if (pestana == "Mensual" && dias < 60)
        {
            AjustarUltimos12Meses();
        }
        else if (pestana != "Mensual" && dias > 90)
        {
            _fechaDesdeLocal = DateTime.Today.AddDays(-14);
            _fechaHastaLocal = DateTime.Today;
        }

        await CargarReporteActual();
    }

    private void AjustarUltimos12Meses()
    {
        var hoy = DateTime.Today;
        _fechaDesdeLocal = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-11);
        _fechaHastaLocal = hoy;
    }

    private async Task AtajoUltimos12Meses()
    {
        AjustarUltimos12Meses();
        await CargarReporteActual();
    }

    private async Task CargarReporteActual()
    {
        if (_fechaHastaLocal < _fechaDesdeLocal)
        {
            _errorRangoFechas = "La fecha final debe ser posterior o igual a la fecha inicial.";
            return;
        }

        _errorRangoFechas = null;
        _cargando = true;

        var (desdeUtc, hastaUtc) = ObtenerRangoFechasUtc();

        try
        {
            switch (_pestañaActiva)
            {
                case "Asistencia":
                    var resAsis = await ReportesService.ConsultarAsistenciaPorSesionAsync(desdeUtc, hastaUtc);
                    if (resAsis.EsExito) _reporteAsistencia = (resAsis.Valor ?? new List<ReporteAsistenciaSesionDto>()).ToList();
                    else _errorRangoFechas = resAsis.MensajeError;
                    break;
                case "Ocupacion":
                    var resOcup = await ReportesService.ConsultarOcupacionAsync(desdeUtc, hastaUtc);
                    if (resOcup.EsExito) _reporteOcupacion = (resOcup.Valor ?? new List<ReporteOcupacionDto>()).ToList();
                    else _errorRangoFechas = resOcup.MensajeError;
                    break;
                case "Inasistencias":
                    var resIna = await ReportesService.ConsultarInasistenciasAsync(desdeUtc, hastaUtc);
                    if (resIna.EsExito) _reporteInasistencias = (resIna.Valor ?? new List<ReporteInasistenciasEventoDto>()).ToList();
                    else _errorRangoFechas = resIna.MensajeError;
                    break;
                case "HorasPico":
                    var resPico = await ReportesService.ConsultarHorasPicoAsync(desdeUtc, hastaUtc);
                    if (resPico.EsExito) _reporteHorasPico = (resPico.Valor ?? new List<ReporteHorasPicoDto>()).ToList();
                    else _errorRangoFechas = resPico.MensajeError;
                    break;
                case "Mensual":
                    var resMensual = await ReportesService.ConsultarResumenMensualAsync(desdeUtc, hastaUtc);
                    if (resMensual.EsExito) _reporteMensual = (resMensual.Valor ?? new List<ReporteResumenMensualDto>()).ToList();
                    else _errorRangoFechas = resMensual.MensajeError;
                    break;
                case "Pantallas":
                    var resPantallas = await ReportesService.ConsultarUsoPantallasAsync(desdeUtc, hastaUtc);
                    if (resPantallas.EsExito) _reportePantallas = (resPantallas.Valor ?? new List<ReporteUsoPantallasDto>()).ToList();
                    else _errorRangoFechas = resPantallas.MensajeError;
                    break;
                case "Uso":
                    var resUso = await ReportesService.ConsultarUsoPlataformaAsync(desdeUtc, hastaUtc);
                    if (resUso.EsExito) _reporteUso = resUso.Valor;
                    else _errorRangoFechas = resUso.MensajeError;
                    break;
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AtajoUltimos7Dias()
    {
        _fechaDesdeLocal = DateTime.Today.AddDays(-7);
        _fechaHastaLocal = DateTime.Today;
        await CargarReporteActual();
    }

    private async Task AtajoEsteMes()
    {
        var hoy = DateTime.Today;
        _fechaDesdeLocal = new DateTime(hoy.Year, hoy.Month, 1);
        _fechaHastaLocal = hoy;
        await CargarReporteActual();
    }

    private async Task AtajoMesAnterior()
    {
        var hoy = DateTime.Today;
        var primerDiaMesActual = new DateTime(hoy.Year, hoy.Month, 1);
        var ultimoDiaMesAnterior = primerDiaMesActual.AddDays(-1);
        _fechaDesdeLocal = new DateTime(ultimoDiaMesAnterior.Year, ultimoDiaMesAnterior.Month, 1);
        _fechaHastaLocal = ultimoDiaMesAnterior;
        await CargarReporteActual();
    }

    private (DateTimeOffset DesdeUtc, DateTimeOffset HastaUtc) ObtenerRangoFechasUtc()
    {
        var desdeUtc = ZonaHoraria.AUtc(_fechaDesdeLocal.Date);
        var hastaUtc = ZonaHoraria.AUtc(_fechaHastaLocal.Date.AddDays(1).AddTicks(-1));
        return (desdeUtc, hastaUtc);
    }

    private async Task ExportarCsvAsistencia()
    {
        var (desdeUtc, hastaUtc) = ObtenerRangoFechasUtc();
        var res = await ReportesService.DescargarCsvAsync("asistencia", desdeUtc, hastaUtc);
        if (res.EsExito && res.Valor != null)
        {
            await JS.InvokeVoidAsync("itmDescarga.descargarTexto", $"reporte-asistencia-{DateTime.UtcNow:yyyyMMdd}.csv", "text/csv;charset=utf-8", res.Valor);
        }
    }

