@* Ventana de resultado (modal centrado, diseño del artifact "Pantallas del estudiante": sello circular, título, datos y botones).
   Confirmación de reserva (RF-002), lista de espera (RF-003), reserva denegada y errores de acción.
   No muestra posición en la lista de espera ni nivel de priorización (RN-020). *@
@using FitnessFrontend.Servicios.Infraestructura
@implements IDisposable
@inject IAvisosService Avisos

@{
    var aviso = Avisos.Activos.FirstOrDefault();
}
@if (aviso != null)
{
    var tipo = aviso.Tipo.ToString().ToLowerInvariant();
    <div class="itm-modal" @onkeydown="AlTeclear" @key="aviso.Id">
        <div class="itm-modal__fondo" aria-hidden="true" @onclick="() => Avisos.Descartar(aviso.Id)"></div>
        <section class="itm-modal__caja" role="@(aviso.Tipo == TipoAviso.Error ? "alertdialog" : "dialog")" aria-modal="true"
                 aria-labelledby="aviso-titulo" aria-describedby="aviso-mensaje" tabindex="-1" @ref="_caja">
            <div class="itm-resultado__sello itm-resultado__sello--@tipo">
                <svg class="itm-icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    @switch (aviso.Tipo)
                    {
                        case TipoAviso.Espera:
                            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                            break;
                        case TipoAviso.Error:
                            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                            break;
                        case TipoAviso.Info:
                            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M12 11v6M12 7.5v.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
                            break;
                        default:
                            <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            break;
                    }
                </svg>
            </div>
            <h2 id="aviso-titulo">@aviso.Titulo</h2>
            @if (!string.IsNullOrWhiteSpace(aviso.Mensaje))
            {
                <p id="aviso-mensaje">@aviso.Mensaje</p>
            }
            @if (aviso.Datos is { Count: > 0 })
            {
                <dl class="itm-datos">
                    @foreach (var dato in aviso.Datos)
                    {
                        <dt>@dato.Etiqueta</dt>
                        <dd>@dato.Valor</dd>
                    }
                </dl>
            }
            <div class="itm-modal__acciones">
                @if (!string.IsNullOrWhiteSpace(aviso.EnlaceTexto) && !string.IsNullOrWhiteSpace(aviso.EnlaceUrl))
                {
                    <a class="btn btn-itm-primario itm-btn-bloque" href="@aviso.EnlaceUrl" @onclick="() => Avisos.Descartar(aviso.Id)">@aviso.EnlaceTexto</a>
                    <button type="button" class="btn btn-itm-secundario itm-btn-bloque" @onclick="() => Avisos.Descartar(aviso.Id)">Seguir viendo actividades</button>
                }
                else
                {
                    <button type="button" class="btn btn-itm-primario itm-btn-bloque" @onclick="() => Avisos.Descartar(aviso.Id)">Entendido</button>
                }
            </div>
        </section>
    </div>
}

@code {
    private ElementReference _caja;
    private Guid _enfocado;

    protected override void OnInitialized() => Avisos.Cambio += AlCambiar;

    private void AlCambiar() => _ = InvokeAsync(StateHasChanged);

    // Lleva el foco a la ventana al abrirla (lectores de pantalla y teclado); Esc la cierra.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var aviso = Avisos.Activos.FirstOrDefault();
        if (aviso != null && aviso.Id != _enfocado)
        {
            _enfocado = aviso.Id;
            await _caja.FocusAsync();
        }
    }

    private void AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            var aviso = Avisos.Activos.FirstOrDefault();
            if (aviso != null) Avisos.Descartar(aviso.Id);
        }
    }

    public void Dispose() => Avisos.Cambio -= AlCambiar;
}
